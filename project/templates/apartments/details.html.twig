{% extends "base.html.twig" %}
{% block content %}
<div class="container mx-auto w-90  p-4 rounded">
    <div class="col">
        <div class="apartment-info row d-flex align-items-center justify-content-between  p-4">
        {% for label, messages in app.flashes %}
                        {% for message in messages %}
                            <div class="alert alert-{{ label }} mt-2">
                                {{ message }}
                            </div>
                        {% endfor %}
                    {% endfor %}
            <!-- Colonne de gauche -->
            <div class="col-sm-6">
                
                <h2 class="fw-bold">{{ apartment.name }}</h2>
                <hr class="w-75">
                
            </div>

            <!-- Colonne de droite -->
            <div class="col-sm-6 d-flex flex-column align-items-end text-gray rounded">
                <h4>256.00 €</h4>
                <span>La nuitée</span>
            </div>
        </div>
        
        <div class="row mt-4 rounded p-4" id="existing-images">
            <div class="col-md-6 image-container" style="height: 400px;"> 
                <img src="{{ asset(apartment.imageUrl) }}" 
                    alt="Image de l'appartement" 
                    class="img-fluid rounded shadow-md preview-image w-100 h-100 object-cover"
                    data-bs-toggle="modal" 
                    data-bs-target="#imageModal"
                    data-image-url="{{ asset(apartment.imageUrl) }}" />
            </div>

            <div class="col-md-6">
                <div class="row">
                    {% set totalImages = apartment.images|length %}
                    {% set imagesToShow = 4 %} {# Afficher 4 images initialement #}

                    {% for image in apartment.images[:imagesToShow] %}
                        <div class="col-md-6 image-container mb-2" style="height: 200px;"> 
                            <img src="{{ asset(image.url) }}" 
                                alt="Image de l'appartement" 
                                class="img-fluid rounded shadow-md preview-image w-100 h-100 object-cover"
                                data-bs-toggle="modal" 
                                data-bs-target="#imageModal"
                                data-image-url="{{ asset(image.url) }}" />
                        </div>
                    {% endfor %}
                </div>
            </div>
        </div>

        <div id="more-images" class="row mt-2 p-4 d-none">
            {% for image in apartment.images[imagesToShow:] %}
                <div class="col-md-4 image-container" style="height: 200px;">
                    <img src="{{ asset(image.url) }}" 
                        alt="Image de l'appartement" 
                        class="img-fluid rounded shadow-md preview-image w-100 h-100 object-cover"
                        data-bs-toggle="modal" 
                        data-bs-target="#imageModal"
                        data-image-url="{{ asset(image.url) }}" />
                </div>
            {% endfor %}
        </div>

        {% if totalImages > imagesToShow %}
            <div class="text-center mt-3">
                <button id="load-more-btn" class="btn border border-orange text-orange">Afficher plus...</button>
            </div>
        {% endif %}
        

        <div class="p-4 m-4">
            <span>{{ apartment.description }}</span>
        </div>
        
        <!-- Fenêtre modale Bootstrap -->
        <div class="modal fade" id="imageModal" tabindex="-1" aria-labelledby="imageModalLabel" aria-hidden="true">
            <div class="modal-dialog  modal-xl modal-dialog-centered">
                <div class="modal-content">
                    <div class="modal-header">
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fermer"></button>
                    </div>
                    <div class="modal-body text-center">
                        <img id="modalImage" src="" class="img-fluid rounded shadow-lg" alt="Aperçu de l'image">
                    </div>
                </div>
            </div>
        </div>

        <div class="row mt-3 rounded p-4 shadow">
            <div class="card col-md-6">
                <div class="row p-4">
                    <h5>Ce que propose cet appartement</h5>
                    
                    <div class="row g-3"> {# Ajoute un gap pour espacer les équipements #}
                        {% for equipment in apartment.equipments %}
                            <div class="col-12 col-md-6 d-flex align-items-center">
                                <img src="{{ asset(equipment.iconUrl) }}" 
                                     alt="Équipement"
                                     class="equipment-icon mx-2"
                                     />
                                <span class="text-md p-2">{{ equipment.name }}</span>
                            </div>
                        {% endfor %}
                    </div>
                </div>
            </div>
            
            
            <div class="col-md-6">
                <div class="bg-white rounded p-3">
                    
                {{ form_start(form, {'attr': {'id': 'reservation-form'}}) }}
                
                    <div class="row border border-radius-4 border-info p-4">
                        <span class="p-2 mb-4 text-muted text-lg fw-bold h4">Réservez votre séjour dès maintenant !</span>
                        <div class="col-md-6 form-group">
                            <span class="text-xs p-2">Date de début</span>
                            {{ form_widget(form.startDate) }}
                        </div>
                        <div class="col-md-6 form-group mt-3 mt-md-0">
                            <span class="text-xs p-2 mb-2">Date de fin</span>
                            {{ form_widget(form.endDate) }}
                        </div>
                    </div>
                    {% for label, messages in app.flashes %}
                        {% for message in messages %}
                            <div class="alert alert-{{ label }} mt-2">
                                {{ message }}
                            </div>
                        {% endfor %}
                    {% endfor %}
                    <div class="alert-no-date mt-2 d-none">
                        <span class="text-xs p-2 text-danger font-semibold">Selectionnez les dates</span>
                    </div>
                    <button class="btn btn-info text-white font-semibold py-2 px-4 rounded mt-4" type="button" id="preview-reservation-btn" >
                        Faire ma réservation
                    </button>
                    
                {{ form_end(form) }}
                </div>
            </div>
        </div>

    </div>
    {# Modal Reservation preview #}
    <div class="modal fade" id="reservation-modal" tabindex="-1" aria-labelledby="recapModalLabel" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="recapModalLabel">Récapitulatif de votre réservation</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fermer"></button>
                </div>
                <div class="modal-body">
                    <p><strong>Date de début :</strong> <span id="recap-start"></span></p>
                    <p><strong>Date de fin :</strong> <span id="recap-end"></span></p>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Annuler</button>
                    <button type="button" class="btn btn-info text-white" id="confirm-reservation">Confirmer la réservation</button>
                </div>
            </div>
        </div>
    </div>
    

</div>

<!-- Script pour gérer l'affichage dans le modal -->
<script>
    document.addEventListener("DOMContentLoaded", function () {
        document.querySelectorAll(".preview-image").forEach(image => {
            image.addEventListener("click", function () {
                const imageUrl = this.getAttribute("src");
                document.getElementById("modalImage").setAttribute("src", imageUrl);
            });
        });
    });

    document.addEventListener("DOMContentLoaded", function () {
    const loadMoreBtn = document.getElementById("load-more-btn");
    const moreImagesContainer = document.getElementById("more-images");

    if (loadMoreBtn) {
        loadMoreBtn.addEventListener("click", function () {
            // Affiche le bloc des images cachées
            moreImagesContainer.classList.remove("d-none");

            // Vérifie s'il reste encore d'autres images à afficher
            let hiddenImages = moreImagesContainer.querySelectorAll(".image-container.d-none");
            if (hiddenImages.length > 0) {
                // Affiche seulement 5 images supplémentaires
                hiddenImages.forEach((image, index) => {
                    if (index < 5) {
                        image.classList.remove("d-none");
                    }
                });

                // S'il n'y a plus d'images cachées, cacher le bouton
                if (moreImagesContainer.querySelectorAll(".image-container.d-none").length === 0) {
                    loadMoreBtn.style.display = "none";
                }
            } else {
                // S'il n'y a plus d'images, cacher le bouton
                loadMoreBtn.style.display = "none";
            }
        });
    }
});

</script>
{% endblock content %}