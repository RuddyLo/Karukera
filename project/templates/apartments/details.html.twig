{% extends "base.html.twig" %}

{% block content %}
<div class="container w-100 p-4 rounded">
    <div class="col">

        {% for label, messages in app.flashes %}
            {% for message in messages %}
                <div class="alert alert-{{ label }} mt-2">{{ message }}</div>
            {% endfor %}
        {% endfor %}

        <div class="row p-4 align-items-center justify-content-between">
            <div class="col-sm-6">
                <h2 class="fw-bold">{{ apartment.name }}</h2>
                <hr class="w-75">
            </div>
            <div class="col-sm-6 text-end">
                <h4 id="page-price-display">{{ price }} € <small class="text-muted fs-6" id="page-price-label">{{ 'apartment_details.price_per_night'|trans }}</small> <small class="text-muted fs-6">(TVA incluses)</small></h4>
            </div>
        </div>

      <div class="row mt-4 p-4">
    <div class="col-md-6" style="height:400px;">
        <img src="{{ asset(apartment.imageUrl) }}" 
             class="img-fluid rounded preview-image w-100 h-100 clickable-image" 
             style="cursor:pointer; object-fit:cover;"
             data-src="{{ asset(apartment.imageUrl) }}">
    </div>
    <div class="col-md-6">
        <div class="row">
            {% for image in apartment.images|slice(0,4) %}
                <div class="col-md-6 mb-2" style="height:200px;">
                    <img src="{{ asset(image.url) }}" 
                         class="img-fluid rounded preview-image w-100 h-100 clickable-image"
                         style="cursor:pointer; object-fit:cover;"
                         data-src="{{ asset(image.url) }}">
                </div>
            {% endfor %}
        </div>

        {% if apartment.images|length > 4 %}
            <div class="text-end mt-2">
                <button class="btn btn-outline-dark" id="show-all-images-btn">
                    {{ 'apartment_details.show_all_images'|trans }} ({{ apartment.images|length }})
                </button>
            </div>
        {% endif %}
    </div>
</div>

{# Galerie complète cachée, affichée au clic du bouton #}
{# Galerie complète cachée - uniquement les images > 4 #}
{% if apartment.images|length > 4 %}
<div id="all-images-gallery" class="row p-4 g-2" style="display:none!important;">
    {% for image in apartment.images|slice(4) %}
        <div class="col-md-3 col-sm-6" style="height:200px;">
            <img src="{{ asset(image.url) }}" 
                 class="img-fluid rounded w-100 h-100 clickable-image"
                 style="cursor:pointer; object-fit:cover;"
                 data-src="{{ asset(image.url) }}">
        </div>
    {% endfor %}
</div>
{% endif %}

{# Modale preview image #}
<div class="modal fade" id="image-preview-modal" tabindex="-1">
    <div class="modal-dialog modal-xl modal-dialog-centered">
        <div class="modal-content bg-dark">
            <div class="modal-header border-0">
                <button class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body text-center p-2">
                <img id="preview-modal-img" src="" class="img-fluid rounded" style="max-height:80vh; object-fit:contain;">
            </div>
        </div>
    </div>
</div>
        </div>

        {% set descWords = apartment.description|split(' ') %}
        {% set isDescLong = descWords|length > 100 %}
        <div class="p-4">
            <div style="white-space: pre-wrap;">{% if isDescLong %}{{ descWords|slice(0, 100)|join(' ') }}…{% else %}{{ apartment.description }}{% endif %}</div>
            {% if isDescLong %}
                <button type="button" class="btn mt-2" style="background-color: var(--color-primary); color: #fff;" data-bs-toggle="modal" data-bs-target="#description-modal">
                    {{ 'apartment_details.read_more'|trans }}
                </button>
            {% endif %}
        </div>

        {% if isDescLong %}
        {# Modale description complète #}
        <div class="modal fade" id="description-modal" tabindex="-1">
            <div class="modal-dialog modal-dialog-scrollable modal-xl modal-dialog-centered">
                <div class="modal-content" style="background: #fff; backdrop-filter: none;">
                    <div class="modal-header">
                        <h5 class="modal-title">{{ 'apartment_details.description_title'|trans }}</h5>
                        <button class="btn-close" data-bs-dismiss="modal"></button>
                    </div>
                    <div class="modal-body" style="white-space: pre-wrap;">{{ apartment.description }}</div>
                </div>
            </div>
        </div>
        {% endif %}

        <div class="row mt-3 p-4 shadow rounded">
            <div class="col-md-6 card p-4">
                <h5>{{ 'apartment_details.equipments_title'|trans }}</h5>
                <div class="row g-3 mt-2">
                    {% for equipment in apartment.equipments %}
                        <div class="col-md-6 d-flex align-items-center">
                            <img src="{{ asset(equipment.iconUrl) }}" class="mx-2" style="width:60px; height:60px;">
                            <span class='p-auto'>{{ equipment.name }}</span>
                        </div>
                    {% endfor %}
                </div>
            </div>

            <div class="col-md-6">
                <div class="bg-white rounded p-3">
                    {{ form_start(form, {'attr': {'id':'reservation-form'}}) }}

                    <div class="border p-4 rounded">
                        <h4 class="fw-bold text-muted mb-2">{{ 'apartment_details.book_title'|trans }}</h4>
                        <div id="calendar"></div>

                        <div class="row mt-4">
                            <div class="col-md-6">
                                {{ form_label(form.startDate, 'Date d\'arrivée') }}
                                {{ form_widget(form.startDate) }}
                            </div>
                            <div class="col-md-6">
                                {{ form_label(form.endDate, 'Date de départ') }}
                                {{ form_widget(form.endDate) }}
                            </div>
                        </div>
                    </div>
                    <div class="p-4">
                        {% if app.user %}
                            <div class="mb-3 mt-3">
                                <div class="form-check mb-2">
                                    <input class="form-check-input" type="checkbox" id="accept-cgv">
                                    <label class="form-check-label small" for="accept-cgv">
                                        J'ai lu et j'accepte les
                                        <a href="#" data-bs-toggle="modal" data-bs-target="#cgv-modal" class="fw-semibold">Conditions Générales de Vente</a>
                                    </label>
                                </div>
                                <div class="form-check">
                                    <input class="form-check-input" type="checkbox" id="accept-privacy">
                                    <label class="form-check-label small" for="accept-privacy">
                                        J'ai lu et j'accepte la
                                        <a href="#" data-bs-toggle="modal" data-bs-target="#privacy-modal" class="fw-semibold">Politique de Confidentialité</a>
                                    </label>
                                </div>
                            </div>
                            <button type="button" id="preview-reservation-btn" class="btn p-4 bg-success text-white mt-2 w-100 opacity-50" disabled style="cursor:not-allowed;">
                                Faire ma réservation
                            </button>
                        {% else %}
                            <a id="login-link" class="btn border mt-4 w-100" href="{{ path('app.login',{'_locale': app.request.locale}) }}?_target_path={{ path('app.apartment.details', {'id': apartment.id})|url_encode }}">
                                {{ 'apartment_details.login_to_book'|trans }}
                            </a>
                        {% endif %}
                    </div>

                    {{ form_end(form, {'render_rest': false}) }}
                </div>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="reservation-modal" tabindex="-1">
    <div class="modal-dialog modal-lg bg-white">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Résumé de la réservation</h5>
                <button class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            

            <div class="modal-body p-4">
                <h6 class="fw-bold mb-3">{{ apartment.name }}</h6>
                <img src="{{ asset(apartment.imageUrl) }}" class="img-fluid rounded mb-2" style="max-height: 60px; width: auto;">

                {% if not is_granted('ROLE_ADMIN') %}
                <div class="mb-3">
                    <small class="text-muted fw-semibold d-block mb-2">Devise de paiement :</small>
                    <div class="btn-group w-100" id="currency-selector">
                        <button type="button" class="btn btn-outline-success active d-flex align-items-center justify-content-center fw-bold fs-5" data-currency="eur" >€ EUR</button>
                        <button type="button" class="btn btn-outline-success d-flex align-items-center justify-content-center fw-bold fs-5" data-currency="brl">R$ BRL</button>
                    </div>
                    <div id="currency-spinner" class="text-center mt-2" style="display:none;">
                        <div class="spinner-border spinner-border-sm text-success" role="status">
                            <span class="visually-hidden">Chargement...</span>
                        </div>
                        <small class="text-muted ms-2">Récupération du taux de change...</small>
                    </div>
                    <div id="exchange-rate-display" class="text-muted small mt-2" style="display:none;"></div>
                </div>
                {% endif %}

                <div class="card mb-4 bg-light">
                    <div class="card-body">
                        <div class="row mb-2">
                            <div class="col-6 text-muted">Période</div>
                            <div class="col-6 text-end">
                                <span id="recap-start"></span> → <span id="recap-end"></span>
                            </div>
                        </div>
                        <div class="row mb-2">
                            <div class="col-6 text-muted">Prix</div>
                            <div class="col-6 text-end" id="apartment_price" data-price="{{ price }}"><span id="apartment_price_value">{{ price }}</span> <span class="currency-symbol">€</span> <small class="text-muted">(TVA incluses)</small></div>
                        </div>
                        <div class="row mb-3 pb-3 border-bottom">
                            <div class="col-6 text-muted">Nuits</div>
                            <div class="col-6 text-end"><span id="recap-days"></span></div>
                        </div>

                        {% if not is_granted('ROLE_ADMIN') %}
                        <div class="row mb-2 text-success" id="coupon-discount-row" style="display:none;">
                            <div class="col-6">{{ 'apartment_details.coupon_discount_label'|trans }} (<span id="coupon-applied-code"></span>)</div>
                            <div class="col-6 text-end fw-bold">−<span id="recap-discount"></span> <span class="currency-symbol">€</span></div>
                        </div>
                        {% endif %}

                        <div class="row mb-3">
                            <div class="col-6 fw-bold fs-5">Montant du séjours</div>
                            <div class="col-6 text-end fw-bold fs-5 text-success">
                                <span id="recap-rent"></span> <span class="currency-symbol">€</span> <small class="text-muted fw-normal fs-6">(TVA incluses)</small>
                            </div>
                        </div>
                    </div>
                </div>

                {% if not is_granted('ROLE_ADMIN') %}
                <div class="card mb-4 border-warning shadow-sm" id="coupon-card">
                    <div class="card-body">
                        <h6 class="fw-bold mb-3"><i class="bi bi-tag-fill text-warning"></i> {{ 'apartment_details.coupon_label'|trans }}</h6>
                        <div class="input-group">
                            <input type="text" id="coupon-code-input" class="form-control text-uppercase" placeholder="{{ 'apartment_details.coupon_placeholder'|trans }}">
                            <button type="button" id="coupon-apply-btn" class="btn btn-warning fw-bold">{{ 'apartment_details.coupon_apply'|trans }}</button>
                        </div>
                        <div id="coupon-message" class="small mt-2"></div>
                        <div id="coupon-applied-banner" class="alert alert-success justify-content-between align-items-center mt-3 mb-0" style="display:none;">
                            <span><i class="bi bi-check-circle-fill"></i> {{ 'apartment_details.coupon_applied'|trans }} <strong id="coupon-applied-code-2"></strong></span>
                            <span class="fw-bold fs-5" id="coupon-rate-badge"></span>
                        </div>
                    </div>
                </div>
                {% endif %}

                <div class="card mb-4 border-info">
                    <div class="card-body">
                        <h6 class="fw-bold text-info mb-3">Information sur la caution</h6>
                        <div class="row mb-2">
                            <div class="col-8">Caution (remboursable)</div>
                            <div class="col-4 text-end"><span id="recap-caution"></span> <span class="currency-symbol">€</span> <small class="text-muted">(TVA incluses)</small></div>
                        </div>
                        <div class="row mb-2 text-muted small">
                            <div class="col-8">+ Frais de transaction</div>
                            <div class="col-4 text-end"><span id="recap-fees"></span> <span class="currency-symbol">€</span> <small class="text-muted">(TVA incluses)</small></div>
                        </div>
                        <div class="row mb-0 pt-2 border-top">
                            <div class="col-8 fw-bold">Total caution</div>
                            <div class="col-4 text-end fw-bold">
                                <span id="recap-caution-total"></span> <span class="currency-symbol">€</span> <small class="text-muted fw-normal">(TVA incluses)</small>
                            </div>
                        </div>
                        <div class="alert alert-info mt-3 mb-0">
                            <small>
                                💡 La caution sera remboursée intégralement
                                (<span id="recap-caution-refund"></span> <span class="currency-symbol">€</span> <small class="text-muted">(TVA incluses)</small>) après votre séjour...
                            </small>
                        </div>
                    </div>
                </div>

                {% if not is_granted('ROLE_ADMIN') %}
                <div class="card mb-4 border-success">
                    <div class="card-body">
                        <h6 class="fw-bold text-success mb-3">Total à payer</h6>
                        <div class="row mb-2">
                            <div class="col-8">Séjour</div>
                            <div class="col-4 text-end"><span id="recap-total-sejour"></span> <span class="currency-symbol">€</span> <small class="text-muted">(TVA incluses)</small></div>
                        </div>
                        <div class="row mb-2">
                            <div class="col-8">Caution (avec frais)</div>
                            <div class="col-4 text-end"><span id="recap-total-caution"></span> <span class="currency-symbol">€</span> <small class="text-muted">(TVA incluses)</small></div>
                        </div>
                        <div class="row fw-bold fs-5 pt-2 border-top">
                            <div class="col-8">Total</div>
                            <div class="col-4 text-end text-success"><span id="recap-grand-total"></span> <span class="currency-symbol">€</span> <small class="text-muted fw-normal fs-6">(TVA incluses)</small></div>
                        </div>
                    </div>
                </div>
                {% endif %}

                <h6 class="fw-bold mb-3">
                    {% if is_granted('ROLE_ADMIN') %}
                        Mode Administrateur
                    {% else %}
                        Informations de paiement
                    {% endif %}
                </h6>
                {% if is_granted('ROLE_ADMIN') %}
                    <div class="alert alert-info mb-3">
                        <i class="bi bi-info-circle"></i>
                        <strong>Mode Admin :</strong> Cette réservation sera créée immédiatement sans paiement Stripe.
                    </div>
                {% else %}
                    <div id="payment-element-rent"></div>
                    <div id="payment-error" class="text-danger mt-3"></div>
                {% endif %}
            </div>

            <div class="modal-footer bg-light">
                <button class="btn btn-secondary" data-bs-dismiss="modal">Annuler</button>
                {% if is_granted('ROLE_ADMIN') %}
                    <button id="checkout-button" class="btn btn-success btn-lg px-5">
                        Créer la réservation →
                    </button>
                {% else %}
                    <button id="checkout-button" class="btn btn-success btn-lg px-5">
                        Payer le séjour →
                    </button>
                {% endif %}
            </div>
        </div>
    </div>
</div>

{# Modal CGV dynamique #}
<div class="modal fade" id="cgv-modal" tabindex="-1" aria-labelledby="cgvModalLabel">
    <div class="modal-dialog modal-xl modal-dialog-scrollable">
        <div class="modal-content" style="background-color: #f8f9fa;">
            <div class="modal-header" style="background-color: #ffffff;">
                <h5 class="modal-title fw-bold" id="cgvModalLabel">Conditions Générales de Location</h5>
                <button class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body" style="background-color: #f8f9fa;">
                <div class="container py-2">
                    {% if 'Karukera' in apartment.name %}
                        {% include 'legal/cgv/_cgv_karukera.html.twig' with { cgv_price: price } %}
                    {% elseif 'Rio' in apartment.name %}
                        {% include 'legal/cgv/_cgv_rio.html.twig' with { cgv_price: price } %}
                    {% else %}
                        <p class="text-danger">Aucune condition générale de location n'est encore configurée pour cet appartement. Merci de contacter le support avant de réserver.</p>
                    {% endif %}
                </div>
            </div>
            <div class="modal-footer">
                <button class="btn btn-outline-secondary" data-bs-dismiss="modal">Fermer</button>
                <button id="cgv-accept-btn" class="btn btn-success" data-bs-dismiss="modal">J'accepte les CGV</button>
            </div>
        </div>
    </div>
</div>

{# Modal Politique de confidentialité #}
<div class="modal fade" id="privacy-modal" tabindex="-1" aria-labelledby="privacyModalLabel">
    <div class="modal-dialog modal-xl modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title fw-bold" id="privacyModalLabel">Politique de Confidentialité</h5>
                <button class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div class="container py-2">
                    <p class="text-muted small mb-4">Mise à jour le {{ "now"|date("d/m/Y") }}</p>

                    <h6 class="fw-bold">1. Collecte des données personnelles</h6>
                    <p>Nous collectons les informations suivantes lors de votre utilisation de notre plateforme :</p>
                    <ul>
                        <li>Nom et prénom</li>
                        <li>Adresse email</li>
                        <li>Numéro de téléphone</li>
                        <li>Adresse postale</li>
                        <li>Données de paiement (traitées de manière sécurisée par Stripe)</li>
                        <li>Historique des réservations</li>
                    </ul>

                    <h6 class="fw-bold">2. Utilisation des données</h6>
                    <p>Vos données personnelles sont utilisées pour :</p>
                    <ul>
                        <li>Gérer vos réservations et votre compte</li>
                        <li>Traiter les paiements</li>
                        <li>Vous contacter concernant vos séjours</li>
                        <li>Respecter nos obligations légales</li>
                    </ul>

                    <h6 class="fw-bold">3. Conservation des données</h6>
                    <p>Vos données sont conservées pendant la durée nécessaire à la fourniture de nos services, dans le respect des obligations légales applicables.</p>

                    <h6 class="fw-bold">4. Vos droits (RGPD)</h6>
                    <p>Conformément au RGPD, vous disposez des droits suivants :</p>
                    <ul>
                        <li><strong>Droit d'accès</strong> à vos données personnelles</li>
                        <li><strong>Droit de rectification</strong> des informations inexactes</li>
                        <li><strong>Droit à l'effacement</strong> ("droit à l'oubli")</li>
                        <li><strong>Droit d'opposition</strong> au traitement de vos données</li>
                        <li><strong>Droit à la portabilité</strong> de vos données</li>
                    </ul>

                    <h6 class="fw-bold">5. Sécurité des données</h6>
                    <p>Nous mettons en œuvre des mesures techniques et organisationnelles appropriées pour protéger vos données contre tout accès non autorisé, toute perte ou destruction.</p>

                    <h6 class="fw-bold">6. Partage des données</h6>
                    <p>Nous ne vendons pas vos données à des tiers. Vos données peuvent être partagées uniquement avec nos prestataires de services (notamment Stripe pour le traitement des paiements) dans le cadre strict de la fourniture de nos services.</p>

                    <h6 class="fw-bold">7. Cookies</h6>
                    <p>Notre site utilise des cookies techniques nécessaires à son fonctionnement. Aucun cookie de tracking tiers n'est utilisé sans votre consentement préalable.</p>

                    <h6 class="fw-bold">8. Contact</h6>
                    <p class="mb-0">Pour toute question relative à la protection de vos données personnelles, vous pouvez nous contacter via la plateforme.</p>
                </div>
            </div>
            <div class="modal-footer">
                <button class="btn btn-outline-secondary" data-bs-dismiss="modal">Fermer</button>
                <button id="privacy-accept-btn" class="btn btn-success" data-bs-dismiss="modal">J'accepte la Politique de Confidentialité</button>
            </div>
        </div>
    </div>
</div>

<script>
window.apartmentId = {{ apartment.id }};
window.stripePublicKey = "{{ stripe_public_key }}";
window.isUserAdmin = {{ is_granted('ROLE_ADMIN') ? 'true' : 'false' }};
window.priceForDateUrl = "{{ path('app.apartment.price_for_date', {id: apartment.id, _locale: app.request.locale}) }}";
window.basePrice = {{ price }};
window.selectedCurrency = 'eur';
window.appLocale = '{{ app.request.locale }}';
window.trans = {
    pricePerNight: '{{ 'apartment_details.price_per_night'|trans }}'
};
</script>

<script src="https://cdn.jsdelivr.net/npm/fullcalendar@6.1.15/index.global.min.js"></script>

<script>
document.addEventListener('DOMContentLoaded', function () {
    const urlParams = new URLSearchParams(window.location.search);
    const searchStartDate = urlParams.get('startDate');
    const searchEndDate = urlParams.get('endDate');

    if (searchStartDate && searchEndDate) {
        document.getElementById('reservation_form_startDate').value = searchStartDate;
        document.getElementById('reservation_form_endDate').value = searchEndDate;
    }
});
</script>

<script>
document.addEventListener('DOMContentLoaded', function () {
    let startDate = null;
    let isSelecting = false;
    let minimumStayRequirements = {};
    let reservedDates = new Set();
    let selectionComplete = false;

    const bookingBtn = document.getElementById('preview-reservation-btn');
    const loginLink = document.getElementById('login-link');
    const baseLoginUrl = '{{ path('app.login', {'_locale': app.request.locale}) }}';
    const apartmentPath = '{{ path('app.apartment.details', {'id': apartment.id}) }}';
    const baseLoginWithTarget = baseLoginUrl + '?_target_path=' + encodeURIComponent(apartmentPath);

    let _datesValid = false;
    let _lastStart = null;
    let _lastEnd = null;

    function areTermsAccepted() {
        const cgv = document.getElementById('accept-cgv');
        const privacy = document.getElementById('accept-privacy');
        return (!cgv || cgv.checked) && (!privacy || privacy.checked);
    }

    function updateBookingBtn() {
        const canBook = _datesValid && areTermsAccepted();
        if (bookingBtn) {
            bookingBtn.disabled = !canBook;
            bookingBtn.classList.toggle('opacity-50', !canBook);
            bookingBtn.style.cursor = canBook ? 'pointer' : 'not-allowed';
        }
    }

    function setBookingValid(isValid, startStr, endStr) {
        _datesValid = isValid;
        _lastStart = startStr || null;
        _lastEnd = endStr || null;
        if (loginLink) {
            if (isValid && startStr && endStr) {
                const target = encodeURIComponent(apartmentPath + '?startDate=' + startStr + '&endDate=' + endStr);
                loginLink.href = baseLoginUrl + '?_target_path=' + target;
            } else {
                loginLink.href = baseLoginWithTarget;
            }
        }
        updateBookingBtn();
    }

    setBookingValid(false);

    function formatDayLabel(dateStr) {
        return new Date(dateStr + 'T00:00:00').toLocaleDateString('fr-FR', { day: '2-digit', month: '2-digit' });
    }

    function formatGroupedBreakdown(groupedBreakdown) {
        return groupedBreakdown.map(g => {
            const range = g.startDate === g.endDate
                ? formatDayLabel(g.startDate)
                : `${formatDayLabel(g.startDate)} → ${formatDayLabel(g.endDate)}`;
            return `<span class="d-block">${range} : ${g.price.toFixed(2)} €</span>`;
        }).join('');
    }

    function fetchAndShowPrice(startStr, showSwal = true, endStr = null) {
        const url = window.priceForDateUrl + '?date=' + startStr + (endStr ? '&end=' + endStr : '');
        fetch(url)
            .then(r => r.json())
            .then(data => {
                const groupedBreakdown = data.groupedBreakdown || null;
                const isMixed = groupedBreakdown && groupedBreakdown.length > 1;

                const priceEl = document.getElementById('page-price-display');
                if (priceEl) {
                    if (isMixed) {
                        priceEl.innerHTML = `${data.total.toFixed(2)} € <small class="text-muted fs-6" id="page-price-label">pour ${data.nights} nuits</small> <small class="text-muted fs-6">(TVA incluses)</small>`;
                    } else {
                        priceEl.innerHTML = data.price + ' € <small class="text-muted fs-6" id="page-price-label">' + (window.trans?.pricePerNight || '/ nuit') + '</small> <small class="text-muted fs-6">(TVA incluses)</small>';
                    }
                }
                const recapPriceEl = document.getElementById('apartment_price');
                if (recapPriceEl) {
                    if (isMixed) {
                        recapPriceEl.innerHTML = `<small>${formatGroupedBreakdown(groupedBreakdown)}</small>`;
                    } else {
                        const valEl = document.getElementById('apartment_price_value');
                        if (valEl) valEl.textContent = data.price;
                    }
                    recapPriceEl.dataset.price = data.price;
                }
                ['cgv-price-1', 'cgv-price-2'].forEach(id => {
                    const el = document.getElementById(id);
                    if (el) el.textContent = data.price;
                });
                if (showSwal && window.Swal) {
                    let html;
                    if (isMixed) {
                        html = `Votre séjour de <strong>${data.nights} nuits</strong> chevauche plusieurs tarifs :<br>` +
                            `<small class="text-muted">${formatGroupedBreakdown(groupedBreakdown)}</small>` +
                            `Total : <strong>${data.total.toFixed(2)} €</strong> <small class="text-muted">(TVA incluses)</small>`;
                    } else {
                        html = `Le tarif applicable est de <strong>${data.price} € / nuit</strong> <small class="text-muted">(TVA incluses)</small>`;
                    }
                    window.Swal.fire({
                        icon: 'info',
                        title: 'Prix pour votre séjour',
                        html,
                        confirmButtonText: 'OK',
                    });
                }
            });
    }

    function resetPriceDisplay() {
        const priceEl = document.getElementById('page-price-display');
        if (priceEl) {
            priceEl.innerHTML = window.basePrice + ' € <small class="text-muted fs-6" id="page-price-label">' + (window.trans?.pricePerNight || '/ nuit') + '</small> <small class="text-muted fs-6">(TVA incluses)</small>';
        }
        const recapPriceEl = document.getElementById('apartment_price');
        if (recapPriceEl) {
            const valEl = document.getElementById('apartment_price_value');
            if (valEl) valEl.textContent = window.basePrice;
            recapPriceEl.dataset.price = window.basePrice;
        }
        ['cgv-price-1', 'cgv-price-2'].forEach(id => {
            const el = document.getElementById(id);
            if (el) el.textContent = window.basePrice;
        });
    }

    const tooltip = document.createElement('div');
    Object.assign(tooltip.style, {
        display: 'none', position: 'fixed', zIndex: '9999',
        background: 'rgba(0,0,0,0.75)', color: '#fff',
        padding: '5px 11px', borderRadius: '6px', fontSize: '12px',
        pointerEvents: 'none', whiteSpace: 'nowrap',
        boxShadow: '0 2px 8px rgba(0,0,0,0.2)', transition: 'opacity .15s'
    });
    document.body.appendChild(tooltip);

    function showTooltip(el, message, isError) {
        const rect = el.getBoundingClientRect();
        tooltip.textContent = message;
        tooltip.style.background = isError ? 'rgba(192,57,43,0.9)' : 'rgba(40,40,40,0.82)';
        tooltip.style.left = (rect.left + rect.width / 2) + 'px';
        tooltip.style.top = (rect.top - 36 + window.scrollY) + 'px';
        tooltip.style.transform = 'translateX(-50%)';
        tooltip.style.position = 'absolute';
        tooltip.style.display = 'block';
    }

    function hideTooltip() {
        tooltip.style.display = 'none';
    }

    function highlightCells(startStr, endStr, isValid) {
        clearHighlight();
        const color = isValid ? 'rgba(97,125,161,0.3)' : 'rgba(231,76,60,0.3)';
        let current = new Date(startStr);
        const end = new Date(endStr);
        // FullCalendar: end est EXCLUSIF, donc marquer jusqu'à end - 1 jour
        end.setDate(end.getDate() + 1); // Convertir endDate inclusif en exclusif
        while (current < end) {
            const dateStr = current.toISOString().split('T')[0];
            const cell = document.querySelector(`[data-date="${dateStr}"]`);
            if (cell) { cell.style.backgroundColor = color; cell.dataset.sel = '1'; }
            current.setDate(current.getDate() + 1);
        }
    }

    function clearHighlight() {
        document.querySelectorAll('[data-sel]').forEach(el => {
            el.style.backgroundColor = '';
            delete el.dataset.sel;
        });
    }

    const urlParams = new URLSearchParams(window.location.search);
    const searchStartDate = urlParams.get('startDate');
    const searchEndDate = urlParams.get('endDate');

    const calendar = new FullCalendar.Calendar(document.getElementById('calendar'), {
        locale: window.appLocale || 'fr',
        selectable: false,
        initialDate: searchStartDate || undefined,
        validRange: {
            start: new Date()
        },
        eventSources: [
            '{{ path("reservations_json", {id: apartment.id}) }}',
            '{{ path("minimumStay_json", {id: apartment.id}) }}'
        ],

        loading(isLoading) {
            if (isLoading || prefillApplied || !searchStartDate || !searchEndDate) return;
            prefillApplied = true;

            const days = Math.ceil((new Date(searchEndDate) - new Date(searchStartDate)) / 86400000);
            if (days < 1) return;

            if (hasReservedInRange(searchStartDate, searchEndDate)) {
                showTooltip(
                    document.querySelector('#calendar .fc-daygrid-day[data-date="' + searchStartDate + '"]') || document.getElementById('calendar'),
                    '⚠ Certaines dates de votre sélection sont déjà réservées',
                    true
                );
                setTimeout(hideTooltip, 4000);
                return;
            }

            const minRequired = getMaxMinimumForRange(searchStartDate, searchEndDate);
            if (days < minRequired ) {
                showTooltip(
                    document.getElementById('calendar'),
                    `⚠ Minimum ${minRequired} nuits requis pour cette période`,
                    true
                );
                setTimeout(hideTooltip, 4000);
                return;
            }

            highlightCells(searchStartDate, searchEndDate, true);
            document.getElementById('reservation_form_startDate').value = searchStartDate;
            document.getElementById('reservation_form_endDate').value = searchEndDate;
            setBookingValid(true, searchStartDate, searchEndDate);
            selectionComplete = true;
            fetchAndShowPrice(searchStartDate, false, searchEndDate);
        },

        eventDidMount(info) {
            const evStart = info.event.startStr;
            const evEnd = info.event.endStr;

            if (info.event.extendedProps.minimumDays) {
                const minDays = info.event.extendedProps.minimumDays;
                let current = new Date(evStart);
                const end = new Date(evEnd);
                while (current < end) {
                    const dateStr = current.toISOString().split('T')[0];
                    minimumStayRequirements[dateStr] = Math.max(minimumStayRequirements[dateStr] || 0, minDays);
                    current.setDate(current.getDate() + 1);
                }
            } else if (info.event.display !== 'background') {
                // Événement de réservation — stocker chaque jour occupé (end exclusif FC)
                reservedDates.add(evStart); // toujours ajouter le start
                let current = new Date(evStart);
                current.setDate(current.getDate() + 1);
                const end = new Date(evEnd);
                while (current < end) {
                    reservedDates.add(current.toISOString().split('T')[0]);
                    current.setDate(current.getDate() + 1);
                }
            }
        },

        dateClick(info) {

            // 👉 RESET (3e clic — sélection complète existante)
            if (selectionComplete) {
                selectionComplete = false;
                clearHighlight();
                document.getElementById('reservation_form_startDate').value = '';
                document.getElementById('reservation_form_endDate').value = '';
                setBookingValid(false);
                hideTooltip();
                resetPriceDisplay();
                lastHoveredDate = null;
                return;
            }

            // 👉 1er clic
            if (!startDate) {
                if (reservedDates.has(info.dateStr)) {
                    showTooltip(info.dayEl, '⚠ Cette date est déjà réservée', true);
                    setTimeout(hideTooltip, 2500);
                    return;
                }
                startDate = info.dateStr;
                isSelecting = true;
                lastHoveredDate = null;
                highlightCells(startDate, startDate, true);
                document.getElementById('reservation_form_startDate').value = '';
                document.getElementById('reservation_form_endDate').value = '';
                setBookingValid(false);
                showTooltip(info.dayEl, 'Sélectionnez la date de fin', false);
            } else {
                // 👉 2e clic → créer range
                let endDate = info.dateStr;
                if (endDate < startDate) [startDate, endDate] = [endDate, startDate];

                const days = Math.ceil((new Date(endDate) - new Date(startDate)) / 86400000);

                if (days < 1) {
                    showTooltip(info.dayEl, '⚠ Sélectionnez une date de départ différente de la date d\'arrivée', true);
                    setTimeout(hideTooltip, 3000);
                    clearHighlight();
                    startDate = null;
                    isSelecting = false;
                    lastHoveredDate = null;
                    return;
                }

                if (hasReservedInRange(startDate, endDate)) {
                    showTooltip(info.dayEl, '⚠ Une date de cette période est déjà réservée', true);
                    setTimeout(hideTooltip, 3000);
                    clearHighlight();
                    startDate = null;
                    isSelecting = false;
                    lastHoveredDate = null;
                    return;
                }

                const minRequired = getMaxMinimumForRange(startDate, endDate);
                if (days < minRequired ) {
                    showTooltip(info.dayEl, `⚠ Minimum ${minRequired} nuits requis`, true);
                    setTimeout(hideTooltip, 3000);
                    clearHighlight();
                    startDate = null;
                    isSelecting = false;
                    lastHoveredDate = null;
                    return;
                }

                highlightCells(startDate, endDate, true);
                document.getElementById('reservation_form_startDate').value = startDate;
                document.getElementById('reservation_form_endDate').value = endDate;
                setBookingValid(true, startDate, endDate);
                selectionComplete = true;
                hideTooltip();
                fetchAndShowPrice(startDate, true, endDate);
                startDate = null;
                isSelecting = false;
                lastHoveredDate = null;
            }
        }
    });

    calendar.render();


    // Pré-remplir une fois les events FullCalendar chargés (reservedDates doit être peuplé)
    let prefillApplied = false;

    // Helper function to get maximum minimum stay requirement for a date range
    function hasReservedInRange(startStr, endStr) {
        // endStr = date de checkout, exclusive : elle redevient disponible en check-in
        let current = new Date(startStr);
        const end = new Date(endStr);
        while (current < end) {
            if (reservedDates.has(current.toISOString().split('T')[0])) return true;
            current.setDate(current.getDate() + 1);
        }
        return false;
    }

    function getMaxMinimumForRange(startStr, endStr) {
        let maxMinimum = 0;
        const start = new Date(startStr);
        const end = new Date(endStr);
        // FullCalendar: end est EXCLUSIF, donc convertir endDate inclusif en exclusif
        end.setDate(end.getDate() + 1);

        let current = new Date(start);
        while (current < end) {
            const dateStr = current.toISOString().split('T')[0];
            maxMinimum = Math.max(maxMinimum, minimumStayRequirements[dateStr] || 0);
            current.setDate(current.getDate() + 1);
        }

        return maxMinimum;
    }

    // Réactualiser le bouton quand les cases sont cochées/décochées
    document.getElementById('accept-cgv')?.addEventListener('change', updateBookingBtn);
    document.getElementById('accept-privacy')?.addEventListener('change', updateBookingBtn);

    // Bouton "J'accepte" dans le modal CGV → coche la case (fermeture via data-bs-dismiss)
    document.getElementById('cgv-accept-btn')?.addEventListener('click', function() {
        const cb = document.getElementById('accept-cgv');
        if (cb) cb.checked = true;
        updateBookingBtn();
    });

    // Bouton "J'accepte" dans le modal Politique → coche la case (fermeture via data-bs-dismiss)
    document.getElementById('privacy-accept-btn')?.addEventListener('click', function() {
        const cb = document.getElementById('accept-privacy');
        if (cb) cb.checked = true;
        updateBookingBtn();
    });

});
</script>
<script>
document.addEventListener('DOMContentLoaded', function () {

    // Afficher toutes les images
    const showBtn = document.getElementById('show-all-images-btn');
    if (showBtn) {
        showBtn.addEventListener('click', function () {
            const gallery = document.getElementById('all-images-gallery');
            gallery.style.setProperty('display', 'flex', 'important');
            gallery.style.flexWrap = 'wrap';
            this.style.display = 'none';
        });
    }

    // Preview au clic
    document.addEventListener('click', function (e) {
        const img = e.target.closest('.clickable-image');
        if (img) {
            document.getElementById('preview-modal-img').src = img.dataset.src;
            const modal = bootstrap.Modal.getOrCreateInstance(document.getElementById('image-preview-modal'));
            modal.show();
        }
    });

});
</script>
