{% extends "base.html.twig" %}

{% block content %}
<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow">
                <div class="card-header bg-success text-white">
                    <h5 class="mb-0">✓ Location payée avec succès</h5>
                </div>
                <div class="card-body">
                    <h6 class="fw-bold mb-4">Étape 2 : Paiement de la caution</h6>
                    
                    <div class="alert alert-info mb-4">
                        <small>La caution vous sera intégralement remboursée après votre séjour si aucun dégât n'est constaté.</small>
                    </div>

                    <div id="payment-element-caution"></div>
                    <div id="payment-error" class="text-danger mt-3"></div>

                    <button id="pay-caution-btn" class="btn btn-success btn-lg w-100 mt-4">
                        Payer la caution
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
const stripe = Stripe("{{ stripe_public_key }}");
const clientSecret = "{{ caution_secret }}";

const elements = stripe.elements({ clientSecret });
const paymentElement = elements.create('payment');
paymentElement.mount('#payment-element-caution');

document.getElementById('pay-caution-btn').addEventListener('click', async function() {
    this.disabled = true;
    this.textContent = 'Traitement...';

    const { error } = await stripe.confirmPayment({
        elements,
        confirmParams: {
            return_url: window.location.origin + '/payment/success',
        }
    });

    if (error) {
        document.getElementById('payment-error').textContent = error.message;
        this.disabled = false;
        this.textContent = 'Payer la caution';
    }
});
</script>
{% endblock %}