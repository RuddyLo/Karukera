{% extends 'base.html.twig' %}

{% block content %}
<section class="legal-page">
    <div class="container py-5">
        <div class="row justify-content-center">
            <div class="col-lg-9">
                <h2 class="fw-bold text-center mb-4">Conditions Générales de Location</h2>

                <ul class="nav nav-tabs mb-4" role="tablist">
                    <li class="nav-item" role="presentation">
                        <button class="nav-link active" id="tab-karukera-btn" data-bs-toggle="tab" data-bs-target="#tab-karukera" type="button" role="tab" aria-controls="tab-karukera" aria-selected="true">
                            Oasis de Karukera
                        </button>
                    </li>
                    <li class="nav-item" role="presentation">
                        <button class="nav-link" id="tab-rio-btn" data-bs-toggle="tab" data-bs-target="#tab-rio" type="button" role="tab" aria-controls="tab-rio" aria-selected="false">
                            Oasis do Rio
                        </button>
                    </li>
                </ul>

                <div class="tab-content">
                    <div class="tab-pane fade show active" id="tab-karukera" role="tabpanel" aria-labelledby="tab-karukera-btn">
                        {% include 'legal/cgv/_cgv_karukera.html.twig' %}
                    </div>
                    <div class="tab-pane fade" id="tab-rio" role="tabpanel" aria-labelledby="tab-rio-btn">
                        {% include 'legal/cgv/_cgv_rio.html.twig' %}
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
{% endblock %}
