{% extends 'base.html.twig' %}

{% block title %}{{ 'search.title'|trans }}{% endblock %}

{% block content %}

<div class="container-fluid p-4" style="">
    <div class="row gx-5" style="height: 100vh; overflow: hidden;">

        <!-- LEFT COLUMN: RESULTS -->
        <div class="col-lg-7" id="left-scroll">
            <div class="results-container">

                <!-- SEARCH FORM -->
                <form class="hero-search gap-y-3 mb-3" method="GET" action="{{ path('app.search_apartment', {_locale: app.request.locale}) }}">

                    <!-- Appartement -->
                    <div class="form-floating">
                        <select class="form-select custom-select-height" id="apartmentSelect" name="apartmentUI">
                            <option value="" disabled selected hidden>{{ 'hero.apartment.placeholder'|trans }}</option>
                            {% for apartment in apartments %}
                                <option value="{{ apartment.name }}" {{ filters.name == apartment.name ? 'selected' : '' }}>
                                    {{ apartment.name }}
                                </option>
                            {% endfor %}
                        </select>
                        <label for="apartmentSelect">{{ 'hero.apartment.label'|trans }}</label>
                    </div>

                    <!-- Date Range -->
                    <div class="field date-range">
                        <div class="form-floating">
                            <input type="text" class="form-control border-0" id="startDateInput"
                                   value="{{ filters.startDate ?? '' }}" placeholder="{{ 'hero.date.arrival'|trans }}" readonly>
                            <label for="startDateInput" style="color: var(--color-secondary-light)">{{ 'hero.date.arrival'|trans }}</label>
                        </div>

                        <span class="separator"></span>

                        <div class="form-floating mb-0 date-trigger" data-type="end">
                            <input type="text" class="form-control border-0" id="endDateInput"
                                   value="{{ filters.endDate ?? '' }}" placeholder="{{ 'hero.date.departure'|trans }}" readonly>
                            <label for="endDateInput" style="color: var(--color-secondary-light)">{{ 'hero.date.departure'|trans }}</label>
                        </div>

                        <div id="calendar-tooltip" class="calendar-tooltip hidden">
                            <div id="calendar"></div>
                        </div>
                    </div>

                    <!-- Guests -->
                    <div class="form-floating">
                        <select class="form-select custom-select-height" id="guestsInput">
                            <option value="" disabled selected hidden>{{ 'hero.guests.placeholder'|trans }}</option>
                            {% for i in 1..10 %}
                                <option value="{{ i }}">{{ i }} {{ 'hero.guests.person'|trans }}{{ i > 1 ? ('hero.guests.plural'|trans) : '' }}</option>
                            {% endfor %}
                        </select>
                        <label for="guestsInput">{{ 'hero.guests.label'|trans }}</label>
                    </div>

                    <button type="submit" class="btn-getstarted search-btn rounded-pill">
                        <i class="bi bi-search"></i> {{ 'hero.search'|trans }}
                    </button>

                    <input type="hidden" name="search_form[name]" id="sf_name" value="{{ filters.name ?? '' }}">
                    <input type="hidden" name="search_form[startDate]" id="sf_start" value="{{ filters.startDate ?? '' }}">
                    <input type="hidden" name="search_form[endDate]" id="sf_end" value="{{ filters.endDate ?? '' }}">
                    <input type="hidden" name="search_form[guests]" id="sf_guests">

                </form>

                <!-- RESULTS -->
                {% if filters.startDate and filters.endDate %}
                    <p class="text-muted mb-3">
                        <i class="bi bi-calendar-check"></i>
                        {{ 'search.availability_for'|trans }} <strong>{{ filters.startDate }}</strong> → <strong>{{ filters.endDate }}</strong>
                    </p>
                {% endif %}

                <div class="row">
                    {% for apartment_result in results %}
                        <div class="card-container d-flex col-md-4 mb-3">
                            <a href="{{ path('app.apartment.details', { id: apartment_result.id, _locale: app.request.locale }) }}"
                               class="text-decoration-none text-dark w-100 shadow">
                                <div class="card appart-card border-0">
                                    <div class="appart-image-wrapper">
                                        <img src="{{ asset(apartment_result.image_url) }}"
                                             alt="{{ apartment_result.name }}"
                                             class="appart-image">
                                    </div>
                                    <div class="card-body p-3">
                                        <h2 class="appart-title mb-1">{{ apartment_result.name }}</h2>
                                        <p class="appart-price mb-1">
                                            <strong>Ar {{ apartment_result.price }}</strong> / nuit
                                        </p>
                                        {% if filters.startDate and filters.endDate %}
                                            <span class="badge bg-success">
                                                <i class="bi bi-check-circle"></i> {{ 'search.available'|trans }}
                                            </span>
                                        {% endif %}
                                    </div>
                                </div>
                            </a>
                        </div>
                    {% else %}
                        <div class="col-12">
                            <div class="alert alert-warning">
                                <i class="bi bi-exclamation-circle"></i>
                                {% if filters.startDate and filters.endDate %}
                                    {{ 'search.no_results_dates'|trans }}
                                {% else %}
                                    {{ 'search.no_results'|trans }}
                                {% endif %}
                            </div>
                        </div>
                    {% endfor %}
                </div>

            </div>
        </div>

        <!-- RIGHT COLUMN: MAP -->
        <div class="col-lg-5">
            <div id="map" style="height: 700px; border-radius: 12px;"></div>
        </div>

    </div>
</div>

<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css"/>
<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
<link href='https://cdn.jsdelivr.net/npm/fullcalendar@6.1.15/index.global.min.css' rel='stylesheet'/>
<script src='https://cdn.jsdelivr.net/npm/fullcalendar@6.1.15/index.global.min.js'></script>

<script>
    const defaultLat = {{ results[0].latitude ?? -18.8792 }};
    const defaultLng = {{ results[0].longitude ?? 47.5079 }};

    const map = L.map('map').setView([defaultLat, defaultLng], 13);
    L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', { maxZoom: 19 }).addTo(map);

    {% for apartment in results %}
        {% if apartment.latitude is defined and apartment.longitude is defined %}
            L.marker([{{ apartment.latitude }}, {{ apartment.longitude }}])
                .addTo(map)
                .bindPopup("<b>{{ apartment.name|e('js') }}</b><br>Ar {{ apartment.price }} / nuit");
        {% endif %}
    {% endfor %}

    document.addEventListener('DOMContentLoaded', function () {

        const sfApartment = document.getElementById('sf_name');
        const sfStart     = document.getElementById('sf_start');
        const sfEnd       = document.getElementById('sf_end');
        const sfGuests    = document.getElementById('sf_guests');

        const uiApartment = document.getElementById('apartmentSelect');
        const startUI     = document.getElementById('startDateInput');
        const endUI       = document.getElementById('endDateInput');
        const guestsUI    = document.getElementById('guestsInput');

        // Sync au submit pour ne rien rater
        document.querySelector('.hero-search').addEventListener('submit', function () {
            sfApartment.value = uiApartment.value;
            sfGuests.value    = guestsUI.value;
        });

        const tooltip = document.getElementById('calendar-tooltip');

        document.querySelectorAll('.date-range, #startDateInput, #endDateInput').forEach(el => {
            el.addEventListener('click', function (event) {
                event.stopPropagation();
                tooltip.classList.remove('hidden');
                setTimeout(() => { calendar.updateSize(); }, 10);
            });
        });

        document.addEventListener('click', function (event) {
            if (!event.target.closest('.calendar-tooltip') && !event.target.closest('.date-trigger')) {
                tooltip.classList.add('hidden');
            }
        });

        var calendar = new FullCalendar.Calendar(document.getElementById('calendar'), {
            initialView: 'dayGridMonth',
            selectable: true,
            locale: '{{ app.request.locale }}',
            select: function (info) {
                startUI.value = info.startStr;
                endUI.value   = info.endStr;
                sfStart.value = info.startStr;
                sfEnd.value   = info.endStr;
                tooltip.classList.add('hidden');
            }
        });

        calendar.render();
    });
</script>

{% endblock %}