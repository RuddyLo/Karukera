{% extends 'base.html.twig' %}

{% block title %}{{ 'search.title'|trans }}{% endblock %}

{% block content %}

<div class="container-fluid p-4" style="">
    <div class="row gx-5" style="height: 100vh; overflow: hidden;">

        <!-- LEFT COLUMN: RESULTS -->
        <div class="col-lg-7" id="left-scroll">
            <div class="results-container">

                <!-- RESULTS -->
                {% if filters.startDate and filters.endDate %}
                    <p class="text-muted mb-3">
                        <i class="bi bi-calendar-check"></i>
                        {{ 'search.availability_for'|trans }} <strong>{{ filters.startDate }}</strong> → <strong>{{ filters.endDate }}</strong>
                    </p>
                {% endif %}

                <div class="row justify-content-center">
                    {% for apartment_result in results %}
                        <div class="card-container d-flex col-md-10 col-sm-12 mx-auto mb-4">
                            <a href="{{ path('app.apartment.details', {
                                    id: apartment_result.id,
                                    _locale: app.request.locale,
                                    startDate: (apartment_result.id in conflictIds) ? null : filters.startDate,
                                    endDate:   (apartment_result.id in conflictIds) ? null : filters.endDate
                                }) }}"
                               class="text-decoration-none text-dark w-100 shadow-sm rounded">
                                <div class="card appart-card border-0 rounded overflow-hidden">
                                    <div class="appart-image-wrapper">
                                        <img src="{{ asset(apartment_result.image_url) }}"
                                             alt="{{ apartment_result.name }}"
                                             class="appart-image">
                                    </div>
                                    <div class="card-body p-3">
                                        <h2 class="appart-title mb-1">{{ apartment_result.name }}</h2>
                                        <p class="appart-price mb-2">
                                            <strong>{{ apartment_result.price }} €</strong> / nuit
                                        </p>
                                        {% if filters.startDate and filters.endDate %}
                                            {% if apartment_result.id in conflictIds %}
                                                <span class="badge bg-warning text-dark">
                                                    <i class="bi bi-exclamation-triangle"></i> Dates partiellement réservées
                                                </span>
                                                <p class="text-muted mt-1 mb-0" style="font-size:11px;">
                                                    Certaines dates sont indisponibles — consultez les détails pour ajuster votre séjour.
                                                </p>
                                            {% else %}
                                                <span class="badge bg-success">
                                                    <i class="bi bi-check-circle"></i> {{ 'search.available'|trans }}
                                                </span>
                                            {% endif %}
                                        {% endif %}
                                    </div>
                                </div>
                            </a>
                        </div>
                    {% else %}
                        <div class="col-12">
                            <div class="alert alert-warning">
                                <i class="bi bi-exclamation-circle"></i>
                                {% if filters.startDate and filters.endDate %}
                                    {{ 'search.no_results_dates'|trans }}
                                {% else %}
                                    {{ 'search.no_results'|trans }}
                                {% endif %}
                            </div>
                        </div>
                    {% endfor %}
                </div>

            </div>
        </div>

        <!-- RIGHT COLUMN: MAP -->
        <div class="col-lg-5">
            <div id="map" style="height: 700px; border-radius: 12px;"></div>
        </div>

    </div>
</div>

<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css"/>
<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>

<script>
    const map = L.map('map').setView([46.6034, 1.8883], 6);
    L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
        maxZoom: 19,
        attribution: '© OpenStreetMap'
    }).addTo(map);

    {% for apartment in results %}
        L.marker([46.6034 + {{ loop.index0 * 0.15 }}, 1.8883 + {{ loop.index0 * 0.2 }}])
            .addTo(map)
            .bindPopup(
                "<b>{{ apartment.name|e('js') }}</b><br>" +
                "<i class='bi bi-geo-alt-fill text-danger'></i> France<br>" +
                "<strong>{{ apartment.price }} €</strong> / nuit"
            );
    {% endfor %}
</script>

{% endblock %}