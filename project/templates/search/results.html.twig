{% extends 'base.html.twig' %}

{% block title %}{{ 'search.title'|trans }}{% endblock %}

{% block content %}

<div class="container-fluid p-4 search-results-page">
    <div class="row gx-5 align-items-start">

        <!-- LEFT COLUMN: RESULTS -->
        <div class="col-12 col-lg-7 d-flex flex-column">
            <div class="results-container flex-fill">

                <!-- RESULTS -->
                {% if filters.startDate and filters.endDate %}
                    <p class="text-muted mb-3" style="background: #f8f9fa; padding: 20px; border: 1px solid #dee2e6; border-radius: 8px;">
                        <i class="bi bi-calendar-check"></i>
                        {{ 'search.availability_for'|trans }} <strong>{{ filters.startDate }}</strong> → <strong>{{ filters.endDate }}</strong>
                    </p>
                {% endif %}

                <div class="row justify-content-center">
                    {% for apartment_result in results %}
                        <div class="card-container d-flex col-md-10 col-sm-12 mx-auto mb-4">
                            <a href="{{ path('app.apartment.details', {
                                    id: apartment_result.id,
                                    _locale: app.request.locale,
                                    startDate: (apartment_result.id in conflictIds) ? null : filters.startDate,
                                    endDate:   (apartment_result.id in conflictIds) ? null : filters.endDate
                                }) }}"
                               class="text-decoration-none text-dark w-100 shadow-sm rounded">
                                <div class="card appart-card border-0 rounded overflow-hidden">
                                    <div class="appart-image-wrapper">
                                        <img src="{{ asset(apartment_result.image_url) }}"
                                             alt="{{ apartment_result.name }}"
                                             class="appart-image"
                                             style="max-width: 600px; max-height: 600px;">
                                    </div>
                                    <div class="card-body p-3">
                                        <h2 class="appart-title mb-1">{{ apartment_result.name }}</h2>
                                        <p class="appart-price mb-2">
                                            <strong>{{ apartment_result.price }} €</strong> / nuit
                                        </p>
                                        {% if filters.startDate and filters.endDate %}
                                            {% if apartment_result.id in conflictIds %}
                                                <span class="badge bg-warning text-dark">
                                                    <i class="bi bi-exclamation-triangle"></i> Dates partiellement réservées
                                                </span>
                                                <p class="text-muted mt-1 mb-0" style="font-size:11px;">
                                                    Certaines dates sont indisponibles — consultez les détails pour ajuster votre séjour.
                                                </p>
                                            {% else %}
                                                <span class="badge bg-success">
                                                    <i class="bi bi-check-circle"></i> {{ 'search.available'|trans }}
                                                </span>
                                            {% endif %}
                                        {% endif %}
                                    </div>
                                </div>
                            </a>
                        </div>
                    {% else %}
                        <div class="col-12">
                            <div class="alert alert-warning">
                                <i class="bi bi-exclamation-circle"></i>
                                {% if filters.startDate and filters.endDate %}
                                    {{ 'search.no_results_dates'|trans }}
                                {% else %}
                                    {{ 'search.no_results'|trans }}
                                {% endif %}
                            </div>
                        </div>
                    {% endfor %}
                </div>

            </div>
        </div>

        <!-- RIGHT COLUMN: MAP -->
        <div class="col-12 col-lg-5">
            <div class="map-wrapper rounded overflow-hidden">
                <div id="map" class="map-responsive"></div>
            </div>
        </div>

    </div>
</div>

<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css"/>
<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>

<script>
    const map = L.map('map').setView([46.6034, 1.8883], 15);
    L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
        maxZoom: 22,
        attribution: '© OpenStreetMap'
    }).addTo(map);

    const specialApartmentLocation = (name) => {
        const normalized = name.toLowerCase();
        if (normalized.includes('oasis de karukera')) {
            return {
                lat: 16.225393,
                lng: -61.386997,
                url: 'https://maps.google.com/?q=16.225393,-61.386997',
                label: 'Localização'
            };
        }

        if (normalized.includes('oasis de rio')) {
            return {
                lat: -22.915005914212728,
                lng: -43.18771229999998,
                url: 'https://maps.app.goo.gl/ZJYJ7xTXLrRrXUHc6?g_st=iw',
                label: 'Endereco do apto'
            };
        }

        return null;
    };

    const markerPositions = [];

    {% for apartment in results %}
        const apartmentName_{{ loop.index0 }} = "{{ apartment.name|e('js') }}";
        const apartmentLocation_{{ loop.index0 }} = specialApartmentLocation(apartmentName_{{ loop.index0 }});
        const markerLatLng_{{ loop.index0 }} = apartmentLocation_{{ loop.index0 }}
            ? [apartmentLocation_{{ loop.index0 }}.lat, apartmentLocation_{{ loop.index0 }}.lng]
            : [46.6034 + {{ loop.index0 * 0.15 }}, 1.8883 + {{ loop.index0 * 0.2 }}];

        let popupContent_{{ loop.index0 }} = "<b>" + apartmentName_{{ loop.index0 }} + "</b><br>" +
            "<strong>{{ apartment.price }} €</strong> / nuit";

        const googleMapsUrl_{{ loop.index0 }} = "https://maps.google.com/?q=" + markerLatLng_{{ loop.index0 }}[0] + "," + markerLatLng_{{ loop.index0 }}[1];
        popupContent_{{ loop.index0 }} += "<br><a href='" + googleMapsUrl_{{ loop.index0 }} + "' target='_blank' rel='noopener'>" + markerLatLng_{{ loop.index0 }}[0] + ", " + markerLatLng_{{ loop.index0 }}[1] + "</a>";

        if (apartmentLocation_{{ loop.index0 }}) {
            popupContent_{{ loop.index0 }} += "<br><a href='" + apartmentLocation_{{ loop.index0 }}.url + "' target='_blank' rel='noopener'>" + apartmentLocation_{{ loop.index0 }}.label + "</a>";
        }

        L.marker(markerLatLng_{{ loop.index0 }})
            .addTo(map)
            .bindPopup(popupContent_{{ loop.index0 }});

        markerPositions.push(markerLatLng_{{ loop.index0 }});
    {% endfor %}

    if (markerPositions.length) {
        map.fitBounds(markerPositions, {
            padding: [40, 40],
            maxZoom: 15
        });
    }
</script>

{% endblock %}