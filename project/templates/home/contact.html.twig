{% extends 'base.html.twig' %}

{% block content %}
<section class="contact ">
  <div class="container">
    <div class="row justify-content-center">
      <div class="col-12 col-md-10 col-lg-8">
        
        <!-- Titre centré -->
        <h1 class="text-center mb-4">Contact</h1>
        
        <!-- Image centrée -->
        <div class="text-center mb-4">
          <img 
            src="{{ asset('images/img/hero-bg-2.jpeg') }}" 
            alt="Contactez-nous" 
            class="img-fluid rounded shadow"
            style="max-width: 500px; width: 100%; height: auto;"
          >
        </div>
        
        <!-- Texte informatif -->
        <div class="text-center mb-4">
          <h3 class="mb-3">Une question ? Contactez-nous !</h3>
          <p class="lead text-muted">
            Contactez-nous par mail ou retrouvez les informations pour joindre 
            votre hôte directement sur votre confirmation mail et sms.
          </p>
        </div>
        
        <!-- Email en évidence -->
        <div class="text-center">
          <a 
            href="mailto:contact@karukera.com" 
            class="btn btn-outline-secondary btn-lg"
          >
            <i class="bi bi-envelope-fill me-2"></i>
            contact@karukera.com
          </a>
        </div>
        
      </div>
    </div>
  </div>
</section>
{% endblock %}