{% extends 'base.html.twig' %}

{% block title %}Les Oasis de Karurio{% endblock %}
{% block header %}
<header
  id="header"
  class="header "
  data-scrollto-offset="0"
>
  {% include "components/navbar.html.twig" %}
  {% include "components/hero.html.twig" %}
</header>

{% endblock header %}
{% block content %}

<body>
  <!-- ======= Services Section ======= -->
  {% if apartments %}
  {% include "components/appartements.html.twig" %}
  {% endif %}

  {% if last_apartments %}
  {% include "components/new.html.twig" %}
  {% endif %}

  {% include "components/services.html.twig" %}

  <!-- ======= Testimonials Section ======= -->
  {% include "components/testimonials.html.twig" %}

  <!-- ======= Recent Blog Posts Section ======= -->
  {% if last_articles is defined and last_articles|length > 0 %}
      {% include "components/blogPosts.html.twig" %}
  {% endif %}


  <a
    href="#"
    class="scroll-top d-flex align-items-center justify-content-center"
  ><i class="bi bi-arrow-up-short"></i></a>
</body>

{% endblock %}