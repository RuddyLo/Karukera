{% extends 'base.html.twig' %}

{% block title %}{{ 'reservations.title'|trans }}{% endblock %}

{% block content %}
<div class="container py-5">

    <h2 class="fw-bold mb-4">{{ 'reservations.title'|trans }}</h2>

    {% for type, messages in app.flashes %}
        {% for message in messages %}
            <div class="alert alert-{{ type }} alert-dismissible fade show" role="alert">
                {{ message|trans }}
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        {% endfor %}
    {% endfor %}

    {% if reservations is empty %}
        <div class="alert alert-info">
            <i class="bi bi-info-circle"></i> {{ 'reservations.empty'|trans }}
        </div>
    {% else %}
        <div class="row">
            {% for item in reservations %}
            {% set reservation = item.reservation %}
            {% set payment = item.payment %}
            <div class="col-md-6 col-lg-4 mb-4">
                <div class="card shadow-sm border-0 h-100">
                    <img src="{{ asset(reservation.apartment.imageUrl) }}"
                         alt="{{ reservation.apartment.name }}"
                         class="card-img-top"
                         style="height: 180px; object-fit: cover;">
                    <div class="card-body">

                        <h5 class="card-title fw-bold">{{ reservation.apartment.name }}</h5>
                        <p class="text-muted small mb-1">
                            <i class="bi bi-hash"></i> Réf :  <strong>{{ reservation.reference }}</strong>
                        </p>

                        <p class="text-muted mb-1">
                            <i class="bi bi-calendar-check"></i>
                            {{ reservation.startDate|date('d/m/Y') }} → {{ reservation.endDate|date('d/m/Y') }}
                        </p>

                        <p class="mb-1">
                            <i class="bi bi-clock"></i>
                            {% set days = (reservation.endDate.timestamp - reservation.startDate.timestamp) / 86400 %}
                            {{ days|round(0, 'floor') }} nuit{{ days > 1 ? 's' : '' }}
                        </p>

                        
                        <!-- Paiements -->
                        {% if payment %}
                        <div class="mt-3 p-2 bg-light rounded">
                            <p class="mb-1 small">
                                <i class="bi bi-cash"></i>
                                {{ 'reservations.rent_paid'|trans }} : <strong>{{ payment.rent_amount }} €</strong>
                            </p>
                            <p class="mb-1 small">
                                <i class="bi bi-shield"></i>
                                {{ 'reservations.caution_amount'|trans }} : <strong>{{ payment.caution_amount }} €</strong>
                            </p>
                            <p class="mb-0 small fw-bold">
                                <i class="bi bi-receipt"></i>
                                {{ 'reservations.total'|trans }} : <strong>{{ payment.total }} €</strong>
                            </p>
                        </div>
                        {% endif %}

                        <!-- Caution statut -->
                        {% if reservation.cautionPaymentIntentId %}
                        <p class="mt-2 mb-0 small">
                            <i class="bi bi-shield-check"></i>
                            {% if reservation.isCautionRefunded %}
                                <span class="text-success">{{ 'reservations.caution.refunded'|trans }}</span>
                            {% elseif reservation.isCautionConcerved %}
                                <span class="text-danger">{{ 'reservations.caution.conserved'|trans }}</span>
                            {% else %}
                                <span class="text-muted">{{ 'reservations.caution.pending'|trans }}</span>
                            {% endif %}
                        </p>
                        {% endif %}

                    </div>
                    <div class="card-footer bg-white border-0 d-flex flex-column gap-2">
                        <a href="{{ path('app.apartment.details', { id: reservation.apartment.id, _locale: app.request.locale }) }}"
                           class="btn btn-outline-primary btn-sm w-100">
                            {{ 'reservations.see_apartment'|trans }}
                        </a>
                        <a href="#" data-bs-toggle="modal" data-bs-target="#cgv-modal-{{ reservation.id }}"
                           class="btn btn-outline-secondary btn-sm w-100">
                            <i class="bi bi-file-text"></i> Consulter les CGV
                        </a>
                    </div>
                </div>
            </div>

            {# Modal CGV dynamique pour la réservation #}
            <div class="modal fade" id="cgv-modal-{{ reservation.id }}" tabindex="-1" aria-labelledby="cgvModalLabel-{{ reservation.id }}">
                <div class="modal-dialog modal-xl modal-dialog-scrollable">
                    <div class="modal-content">
                        <div class="modal-header">
                            <h5 class="modal-title fw-bold" id="cgvModalLabel-{{ reservation.id }}">Conditions Générales de Vente</h5>
                            <button class="btn-close" data-bs-dismiss="modal"></button>
                        </div>
                        <div class="modal-body">
                            <div class="container py-2">
                                <p class="text-muted small mb-4">Document généré le {{ "now"|date("d/m/Y") }}</p>

                                <h6 class="fw-bold">PARTIES</h6>
                                <div class="border rounded p-3 mb-4 bg-light">
                                    <p class="mb-1"><strong>Locataire :</strong></p>
                                    <p class="mb-1">{{ app.user.firstName }} {{ app.user.lastName }}</p>
                                    <p class="mb-1">Email : {{ app.user.email }}</p>
                                    {% if app.user.phone %}<p class="mb-1">Téléphone : {{ app.user.phone }}</p>{% endif %}
                                    {% if app.user.address %}<p class="mb-0">Adresse : {{ app.user.address }}</p>{% endif %}
                                </div>

                                <h6 class="fw-bold">Article 1 – Objet de la location</h6>
                                <p>Le présent contrat porte sur la location saisonnière de l'hébergement suivant :</p>
                                <div class="border rounded p-3 mb-4 bg-light">
                                    <p class="mb-1 fw-semibold">{{ reservation.apartment.name }}</p>
                                    {% if reservation.apartment.description %}<p class="mb-2 text-muted small">{{ reservation.apartment.description }}</p>{% endif %}
                                    <p class="mb-0"><strong>Prix de base :</strong> {{ reservation.apartment.price }} € / nuit</p>
                                    {% if reservation.apartment.equipments|length > 0 %}
                                    <p class="mb-1 mt-2 fw-semibold small">Équipements inclus :</p>
                                    <ul class="mb-0 small">
                                        {% for equipment in reservation.apartment.equipments %}
                                        <li>{{ equipment.name }}</li>
                                        {% endfor %}
                                    </ul>
                                    {% endif %}
                                </div>

                                <h6 class="fw-bold">Article 2 – Durée de la location</h6>
                                <p>La durée exacte sera précisée lors de la confirmation de la réservation. La réservation ne devient définitive qu'après réception et confirmation du paiement.</p>

                                <h6 class="fw-bold">Article 3 – Prix et modalités de paiement</h6>
                                <p>3.1 Le prix de la location est de <strong>{{ reservation.apartment.price }} € par nuit</strong>.</p>
                                <p>3.2 Le montant total est calculé en fonction du nombre de dates réservées.</p>
                                <p>3.3 Le paiement est effectué intégralement à la réservation par carte bancaire via la plateforme de paiement sécurisée Stripe.</p>

                                <h6 class="fw-bold">Article 4 – Dépôt de garantie</h6>
                                <p>4.1 Un dépôt de garantie forfaitaire est prélevé au moment de la réservation selon la durée du séjour : <strong>400 € pour 1 à 3 nuits</strong> et <strong>500 € au-delà de 3 nuits</strong>.</p>
                                <p>4.2 Ce dépôt est remboursable dans son intégralité dans un délai de 7 jours ouvrés suivant la fin du séjour, sous réserve de l'état du logement.</p>
                                <p>4.3 En cas de dégradations constatées, le bailleur se réserve le droit de conserver tout ou partie du dépôt de garantie.</p>

                                <h6 class="fw-bold">Article 5 – Conditions d'annulation</h6>
                                <ul>
                                    <li>Plus de 30 jours avant l'arrivée : remboursement intégral</li>
                                    <li>Entre 15 et 30 jours avant l'arrivée : remboursement à 50 %</li>
                                    <li>Moins de 15 jours avant l'arrivée : aucun remboursement</li>
                                </ul>
                                <p>En cas d'annulation par le bailleur : remboursement intégral du montant payé.</p>

                                <h6 class="fw-bold">Article 6 – Obligations du locataire</h6>
                                <ul>
                                    <li>Utiliser le logement en bon père de famille</li>
                                    <li>Respecter le règlement intérieur fourni lors de l'entrée dans les lieux</li>
                                    <li>Ne pas dépasser la capacité d'accueil maximale autorisée</li>
                                    <li>Ne pas organiser de fêtes ou rassemblements sans accord préalable</li>
                                    <li>Restituer le logement dans l'état de propreté et d'ordre initial</li>
                                    <li>Il est strictement interdit de fumer à l'intérieur du logement</li>
                                </ul>

                                <h6 class="fw-bold">Article 7 – Responsabilités</h6>
                                <p>Le locataire est responsable de tous les dommages causés au logement et à son contenu durant son séjour. Il est vivement conseillé de souscrire une assurance villégiature couvrant sa responsabilité civile.</p>

                                <h6 class="fw-bold">Article 8 – Droit applicable</h6>
                                <p class="mb-0">Le présent contrat est soumis au droit français. Tout litige sera soumis aux tribunaux compétents du ressort de la juridiction du lieu de situation du bien.</p>
                            </div>
                        </div>
                        <div class="modal-footer">
                            <button class="btn btn-outline-secondary" data-bs-dismiss="modal">Fermer</button>
                        </div>
                    </div>
                </div>
            </div>

            {% endfor %}
        </div>
    {% endif %}

</div>
{% endblock %}