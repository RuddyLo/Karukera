{% extends 'base.html.twig' %}

{% block title %}{{ 'reservations.title'|trans }}{% endblock %}

{% block content %}
<div class="container py-5">

    <h2 class="fw-bold mb-4">{{ 'reservations.title'|trans }}</h2>

    {% for type, messages in app.flashes %}
        {% for message in messages %}
            <div class="alert alert-{{ type }} alert-dismissible fade show" role="alert">
                {{ message|trans }}
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        {% endfor %}
    {% endfor %}

    {% if reservations is empty %}
        <div class="alert alert-info">
            <i class="bi bi-info-circle"></i> {{ 'reservations.empty'|trans }}
        </div>
    {% else %}
        <div class="row">
            {% for item in reservations %}
            {% set reservation = item.reservation %}
            {% set payment = item.payment %}
            <div class="col-md-6 col-lg-4 mb-4">
                <div class="card shadow-sm border-0 h-100">
                    <img src="{{ asset(reservation.apartment.imageUrl) }}"
                         alt="{{ reservation.apartment.name }}"
                         class="card-img-top"
                         style="height: 180px; object-fit: cover;">
                    <div class="card-body">

                        <h5 class="card-title fw-bold">{{ reservation.apartment.name }}</h5>
                        <p class="text-muted small mb-1">
                            <i class="bi bi-hash"></i> Réf :  <strong>{{ reservation.reference }}</strong>
                        </p>

                        <p class="text-muted mb-1">
                            <i class="bi bi-calendar-check"></i>
                            {{ reservation.startDate|date('d/m/Y') }} → {{ reservation.endDate|date('d/m/Y') }}
                        </p>

                        <p class="mb-1">
                            <i class="bi bi-clock"></i>
                            {% set days = (reservation.endDate.timestamp - reservation.startDate.timestamp) / 86400 %}
                            {{ days|round(0, 'floor') }} nuit{{ days > 1 ? 's' : '' }}
                        </p>

                        
                        <!-- Paiements -->
                        {% if payment %}
                        <div class="mt-3 p-2 bg-light rounded">
                            <p class="mb-1 small">
                                <i class="bi bi-cash"></i>
                                {{ 'reservations.rent_paid'|trans }} : <strong>{{ payment.rent_amount }} {{ payment.currency_symbol }}</strong> <small class="text-muted">(TVA incluses)</small>
                            </p>
                            <p class="mb-1 small">
                                <i class="bi bi-shield"></i>
                                {{ 'reservations.caution_amount'|trans }} : <strong>{{ payment.caution_amount }} {{ payment.currency_symbol }}</strong> <small class="text-muted">(TVA incluses)</small>
                            </p>
                            <p class="mb-0 small fw-bold">
                                <i class="bi bi-receipt"></i>
                                {{ 'reservations.total'|trans }} : <strong>{{ payment.total }} {{ payment.currency_symbol }}</strong> <small class="text-muted">(TVA incluses)</small>
                            </p>
                        </div>
                        {% endif %}

                        <!-- Caution statut -->
                        {% if reservation.cautionPaymentIntentId %}
                        <p class="mt-2 mb-0 small">
                            <i class="bi bi-shield-check"></i>
                            {% if reservation.isCautionRefunded %}
                                <span class="text-success">{{ 'reservations.caution.refunded'|trans }}</span>
                            {% elseif reservation.isCautionConcerved %}
                                <span class="text-danger">{{ 'reservations.caution.conserved'|trans }}</span>
                            {% else %}
                                <span class="text-muted">{{ 'reservations.caution.pending'|trans }}</span>
                            {% endif %}
                        </p>
                        {% endif %}

                    </div>
                    <div class="card-footer bg-white border-0 d-flex flex-column gap-2">
                        <a href="{{ path('app.apartment.details', { id: reservation.apartment.id, _locale: app.request.locale }) }}"
                           class="btn btn-outline-primary btn-sm w-100">
                            {{ 'reservations.see_apartment'|trans }}
                        </a>
                        <a href="#" data-bs-toggle="modal" data-bs-target="#cgv-modal-{{ reservation.id }}"
                           class="btn btn-outline-secondary btn-sm w-100">
                            <i class="bi bi-file-text"></i> Consulter les CGV
                        </a>
                    </div>
                </div>
            </div>

            {# Modal CGV dynamique pour la réservation #}
            <div class="modal fade" id="cgv-modal-{{ reservation.id }}" tabindex="-1" aria-labelledby="cgvModalLabel-{{ reservation.id }}">
                <div class="modal-dialog modal-xl modal-dialog-scrollable">
                    <div class="modal-content" style="background-color: #f8f9fa;">
                        <div class="modal-header" style="background-color: #ffffff;">
                            <h5 class="modal-title fw-bold" id="cgvModalLabel-{{ reservation.id }}">Conditions Générales de Location</h5>
                            <button class="btn-close" data-bs-dismiss="modal"></button>
                        </div>
                        <div class="modal-body" style="background-color: #f8f9fa;">
                            <div class="container py-2">
                                <h5 class="fw-bold text-center mb-1">CONDITIONS GÉNÉRALES DE LOCATION COURTE DURÉE</h5>
                                <p class="text-muted small text-center mb-4">Document généré le {{ "now"|date("d/m/Y") }}</p>

                                <h6 class="fw-bold">1. Parties</h6>
                                <div class="border rounded p-3 mb-3 bg-light">
                                    <p class="mb-1"><strong>Le Bailleur :</strong></p>
                                    <p class="mb-0">Nom : Oasis de Karukera</p>
                                    <p class="mb-0">Adresse : 12 rue du morne tricolore 97180 Sainte Anne</p>
                                    <p class="mb-0">Email : contact@oasiskarurio.com</p>
                                    <p class="mb-0">WhatsApp : +33 7 55 50 30 86</p>
                                </div>
                                <div class="border rounded p-3 mb-4 bg-light">
                                    <p class="mb-1"><strong>Le Locataire :</strong></p>
                                    <p class="mb-0">Nom : {{ app.user.firstName }} {{ app.user.lastName }}</p>
                                    {% if app.user.address %}<p class="mb-0">Adresse : {{ app.user.address }}</p>{% endif %}
                                    <p class="mb-0">Email : {{ app.user.email }}</p>
                                    {% if app.user.phone %}<p class="mb-0">Téléphone : {{ app.user.phone }}</p>{% endif %}
                                </div>

                                <h6 class="fw-bold">2. Objet du contrat</h6>
                                <p>Le présent contrat concerne la location saisonnière du logement suivant :</p>
                                <div class="border rounded p-3 mb-4 bg-light">
                                    <p class="mb-0">Adresse : 12 rue du morne tricolore 97180 Sainte Anne</p>
                                    <p class="mb-0">Logement : {{ reservation.apartment.name }}</p>
                                    <p class="mb-0">Type : Appartement</p>
                                    <p class="mb-0">Capacité maximale : 4</p>
                                </div>
                                <p>Le logement est loué à titre de résidence temporaire et de courte durée, à usage exclusif d'habitation.</p>

                                <h6 class="fw-bold">3. Acceptation</h6>
                                <p>La validation de la réservation via le paiement et la case cochée vaut acceptation pleine et entière des présentes conditions.</p>
                                <p>Cette acceptation constitue une signature électronique juridiquement valable.</p>

                                <h6 class="fw-bold">4. Réservation</h6>
                                <p>La réservation est confirmée dès validation du paiement.</p>
                                <p>Le client garantit :</p>
                                <ul>
                                    <li>être majeur</li>
                                    <li>utiliser des informations exactes</li>
                                    <li>être responsable des occupants</li>
                                </ul>

                                <h6 class="fw-bold">5. Séjour</h6>
                                <ul>
                                    <li>Check-in : à partir de 16h</li>
                                    <li>Check-out : avant 11h</li>
                                </ul>
                                <p>Tout dépassement pourra être facturé.</p>

                                <h6 class="fw-bold">6. Prix</h6>
                                <p>Le prix inclut :</p>
                                <ul>
                                    <li>logement meublé</li>
                                    <li>charges (eau, électricité, internet)</li>
                                </ul>
                                <p>Peuvent s'ajouter :</p>
                                <ul>
                                    <li>ménage</li>
                                    <li>frais additionnels spécifiques</li>
                                </ul>

                                <h6 class="fw-bold">7. Caution</h6>
                                {% if payment %}
                                <p>Un dépôt de garantie de <strong>{{ payment.caution_amount }} {{ payment.currency_symbol }}</strong> <small class="text-muted">(TVA incluses)</small> a été prélevé au moment de la réservation.</p>
                                {% else %}
                                <p>Un dépôt de garantie peut être exigé selon la durée du séjour.</p>
                                {% endif %}
                                <p>Le client autorise expressément la retenue en cas de :</p>
                                <ul>
                                    <li>dommages</li>
                                    <li>non-respect du règlement</li>
                                    <li>frais exceptionnels</li>
                                </ul>
                                <p>En cas de dommages constatés supérieurs au montant de la caution, le montant de l'indemnisation pourrait être prélevé directement via le moyen de paiement utilisé lors de la réservation. Dans l'éventualité d'absence des fonds nécessaires, le client s'engage à régler dans les meilleurs délais les préjudices subis par un autre moyen de paiement valide.</p>

                                <h6 class="fw-bold">8. Utilisation</h6>
                                <p>Le logement est destiné à un usage strictement privé.</p>
                                <p>Interdictions :</p>
                                <ul>
                                    <li>fêtes non autorisées</li>
                                    <li>nuisances sonores</li>
                                    <li>dépassement de capacité</li>
                                </ul>
                                <p>En cas de non-respect : résiliation immédiate sans remboursement.</p>

                                <h6 class="fw-bold">9. Règlement intérieur</h6>
                                <p>Le règlement intérieur est opposable au client. Il comprend notamment :</p>
                                <ul>
                                    <li>règles de voisinage</li>
                                    <li>tabac strictement interdit au sein de la structure</li>
                                    <li>utilisation des équipements qui doivent être restitués dans leur état original</li>
                                </ul>

                                <h6 class="fw-bold">10. Politique d'annulation</h6>
                                <p>L'annulation d'une réservation peut être effectuée :</p>
                                <ul>
                                    <li>jusqu'à 14 jours avant la date de check-in : remboursement intégral</li>
                                    <li>jusqu'à 7 jours avant : remboursement de 50 % du montant de la réservation</li>
                                </ul>
                                <p>Aucune exception ne sera accordée sauf cas légal ou force majeure.</p>

                                <h6 class="fw-bold">11. Responsabilité</h6>
                                <p>Le locataire est responsable :</p>
                                <ul>
                                    <li>des dommages</li>
                                    <li>des dégradations</li>
                                    <li>des comportements des occupants</li>
                                </ul>
                                <p>Le propriétaire décline toute responsabilité en cas de :</p>
                                <ul>
                                    <li>vol</li>
                                    <li>perte</li>
                                    <li>accident</li>
                                </ul>

                                <h6 class="fw-bold">12. Force majeure</h6>
                                <p>Aucun remboursement ne pourra être exigé en cas d'événements extérieurs indépendants :</p>
                                <ul>
                                    <li>catastrophes</li>
                                    <li>restrictions gouvernementales</li>
                                    <li>événements imprévisibles</li>
                                </ul>

                                <h6 class="fw-bold">13. Loi applicable</h6>
                                <ul>
                                    <li>Guadeloupe : droit français</li>
                                    <li>Brésil : droit brésilien</li>
                                </ul>
                                <p>Litige : juridiction locale du bien.</p>

                                <h6 class="fw-bold">14. Preuve</h6>
                                <p class="mb-0">Les données électroniques (IP, timestamp, validation) font foi en cas de litige.</p>
                            </div>
                        </div>
                        <div class="modal-footer">
                            <button class="btn btn-outline-secondary" data-bs-dismiss="modal">Fermer</button>
                        </div>
                    </div>
                </div>
            </div>

            {% endfor %}
        </div>
    {% endif %}

</div>
{% endblock %}