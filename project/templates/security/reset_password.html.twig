{% extends 'base.html.twig' %}

{% block title %}{{ 'reset.new.title'|trans }}{% endblock %}

{% block content %}
<section class="">
    <div class="container h-100">
        <div class="row d-flex justify-content-center align-items-center h-100">
            <div class="card" style="border-radius: 1rem; max-width: 30vw;">
                <div class="row g-0">
                    <div class="d-flex align-items-center">
                        <div class="card-body p-4 p-lg-5 text-black">

                            {% for type, messages in app.flashes %}
                                {% for message in messages %}
                                    <div class="alert alert-{{ type }} alert-dismissible fade show" role="alert">
                                        {{ message|trans }}
                                        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                                    </div>
                                {% endfor %}
                            {% endfor %}

                            <h5 class="fw-normal mb-3 pb-3" style="letter-spacing: 1px;">{{ 'reset.new.subtitle'|trans }}</h5>

                            {{ form_start(form, {'attr': {'id': 'reset-password-form'}}) }}
                                <div class="form-outline mb-4">
                                    {{ form_row(form.plainPassword) }}
                                </div>
                                {# Captcha invisible v3 #}
                                {{ form_widget(form.captcha) }}
                                {{ form_row(form.submit) }}
                            {{ form_end(form) }}

                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<script src="https://www.google.com/recaptcha/api.js?render={{ recaptcha_key }}&onload=recaptchaCallback_new_password_captcha" async defer></script>
<script>
    var recaptchaCallback_new_password_captcha = function() {
        grecaptcha.execute('{{ recaptcha_key }}', {action: 'reset_password'}).then(function(token) {
            document.getElementById('new_password_captcha').value = token;
        });
    };

    document.getElementById('reset-password-form').addEventListener('submit', function(e) {
        e.preventDefault();
        const form = this;
        grecaptcha.ready(function() {
            grecaptcha.execute('{{ recaptcha_key }}', {action: 'reset_password'}).then(function(token) {
                document.getElementById('new_password_captcha').value = token;
                form.submit();
            });
        });
    });
</script>
{% endblock %}