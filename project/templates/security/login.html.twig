{% extends 'base.html.twig' %}

{% block title %}Connexion{% endblock %}

{% block content %}
    <form method="post">
        

        
        <section class="">
            
            <div class="container h-100">
                <div class="row d-flex justify-content-center align-items-center h-100">
                    <div class="card" style="border-radius: 1rem; max-width: 30vw;">
                        <div class="row g-0">
                            
                            <div class="d-flex align-items-center">
                                <div class="card-body p-4 p-lg-5 text-black">
                                    {% for type, messages in app.flashes %}
                            {% for message in messages %}
                                <div class="alert alert-{{ type }} alert-dismissible fade show" role="alert">
                                    {{ message }}
                                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                                </div>
                            {% endfor %}
                        {% endfor %}
                                    <form>
                    
                    
                                    <h5 class="fw-normal mb-3 pb-3" style="letter-spacing: 1px;">Connectez-vous à votre compte</h5>
                    
                                    <div data-mdb-input-init class="form-outline mb-4">
                                        <input type="email" value="{{ last_username }}" name="_username" id="form2Example17" class="form-control form-control-lg" required />
                                        <label class="form-label" for="form2Example17">Adresse email</label>
                                    </div>
                    
                                    <div data-mdb-input-init class="form-outline mb-4">
                                        <input type="password" name="_password" id="form2Example27" class="form-control form-control-lg" required />
                                        <label class="form-label" for="form2Example27">Mot de passe</label>
                                    </div>
                    
                                    <input type="hidden" name="_csrf_token"
                                        value="{{ csrf_token('authenticate') }}"
                                    >
                                    <div class="pt-1 mb-4">
                                        <button data-mdb-button-init data-mdb-ripple-init class="btn btn-info btn-lg btn-block w-100 text-white" type="submit">Se connecter</button>
                                    </div>
                                    {% if error %}
                                        <div class="alert alert-danger">{{ error.messageKey|trans(error.messageData, 'security') }}</div>
                                    {% endif %}
                                    <p class="mt-3">
                                        Pas encore de compte ? <a href="{{ path('app.register', {_locale: app.request.locale}) }}">Inscrivez-vous ici</a>.
                                    </p>
                    
                                    </form>
                    
                                </div>
                            </div>
                        </div>
                    </div>
                
                </div>
            </div>

          </section>

        

        {#
            Uncomment this section and add a remember_me option below your firewall to activate remember me functionality.
            See https://symfony.com/doc/current/security/remember_me.html

            <div class="checkbox mb-3">
                <label>
                    <input type="checkbox" name="_remember_me"> Remember me
                </label>
            </div>
        #}

        
    
{% endblock %}
