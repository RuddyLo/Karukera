{% extends 'base.html.twig' %}

{% block title %}{{ 'login.title'|trans }}{% endblock %}

{% block content %}
<section class="">
    <div class="container h-100">
        <div class="row d-flex justify-content-center align-items-center h-100">
            <div class="col-12 col-sm-10 col-md-8 col-lg-6 mx-auto">
                <div class="card login-card">
                    <div class="card-body p-4 p-lg-5 text-black">

                        {% for type, messages in app.flashes %}
                            {% for message in messages %}
                                <div class="alert alert-{{ type }} alert-dismissible fade show" role="alert">
                                    {{ message|trans }}
                                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                                </div>
                            {% endfor %}
                        {% endfor %}

                        <form method="post" id="login-form">
                            <h5 class="fw-normal mb-3 pb-3" style="letter-spacing: 1px;">{{ 'login.subtitle'|trans }}</h5>

                            <div class="form-outline mb-4">
                                <input type="email" value="{{ last_username }}" name="_username" id="form2Example17" class="form-control form-control-lg" required />
                                <label class="form-label" for="form2Example17">{{ 'login.email'|trans }}</label>
                            </div>

                            <div class="form-outline mb-4">
                                <input type="password" name="_password" id="form2Example27" class="form-control form-control-lg" required />
                                <label class="form-label" for="form2Example27">{{ 'login.password'|trans }}</label>
                            </div>

                            <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">

                            {# Captcha invisible v3 #}
                            <input type="hidden" id="login_captcha" name="login[captcha]" />

                            <div class="pt-1 mb-4">
                                <button class="btn btn-info btn-lg btn-block w-100 text-white" type="submit">{{ 'login.submit'|trans }}</button>
                            </div>

                            {% if error %}
                                <div class="alert alert-danger">{{ error.messageKey|trans(error.messageData, 'security') }}</div>
                            {% endif %}

                            <p class="mt-3">
                                {{ 'login.no_account'|trans }}
                                <a href="{{ path('app.register', {_locale: app.request.locale}) }}">{{ 'login.register_link'|trans }}</a>
                            </p>
                            <p class="mt-2">
                                <a href="{{ path('app.forgot_password', {_locale: app.request.locale}) }}">{{ 'login.forgot_password'|trans }}</a>
                            </p>
                        </form>

                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<script src="https://www.google.com/recaptcha/api.js?render={{ recaptcha_key }}&onload=recaptchaCallback_login_captcha" async defer></script>
<script>
    var recaptchaCallback_login_captcha = function() {
        grecaptcha.execute('{{ recaptcha_key }}', {action: 'login'}).then(function(token) {
            document.getElementById('login_captcha').value = token;
        });
    };

    document.getElementById('login-form').addEventListener('submit', function(e) {
        e.preventDefault();
        const form = this;
        grecaptcha.ready(function() {
            grecaptcha.execute('{{ recaptcha_key }}', {action: 'login'}).then(function(token) {
                document.getElementById('login_captcha').value = token;
                form.submit();
            });
        });
    });
</script>
{% endblock %}