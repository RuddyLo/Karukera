{% extends 'admin/admin.base.html.twig' %}

{% block content %}
<div class="container py-4">
    <div class="mb-4">
        <a href="{{ path('admin_reservations_list') }}" class="btn btn-secondary">
            ← Retour à la liste
        </a>
    </div>

    {% for label, messages in app.flashes %}
        {% for message in messages %}
            <div class="alert alert-{{ label }} alert-dismissible fade show">
                {{ message }}
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        {% endfor %}
    {% endfor %}

    <div class="row">
        <div class="col-md-8">
            <div class="card shadow mb-4">
                <div class="card-header bg-secondary text-white">
                    <h5 class="mb-0">Réservation #{{ reservation.id }}</h5>
                </div>
                <div class="card-body">
                    <div class="row mb-3">
                        <div class="col-md-6">
                            <h6 class="text-muted">Client</h6>
                            <p class="fw-bold">
                                {{ reservation.user.email }}
                                <br>
                                <small class="text-muted">{{ reservation.user.email }}</small>
                            </p>
                        </div>
                        <div class="col-md-6">
                            <h6 class="text-muted">Appartement</h6>
                            <p class="fw-bold">{{ reservation.apartment.name }}</p>
                        </div>
                    </div>

                    <div class="row mb-3">
                        <div class="col-md-6">
                            <h6 class="text-muted">Date de début</h6>
                            <p class="fw-bold">{{ reservation.startDate|date('d/m/Y') }}</p>
                        </div>
                        <div class="col-md-6">
                            <h6 class="text-muted">Date de fin</h6>
                            <p class="fw-bold">{{ reservation.endDate|date('d/m/Y') }}</p>
                        </div>
                        <div class="col-md-6">
                            <h6 class="text-muted">Durée</h6>
                            {% set nights = (reservation.endDate.timestamp - reservation.startDate.timestamp) / 86400 %}
                            <p class="fw-bold">{{ nights|round(0, 'floor') }} nuit{{ nights > 1 ? 's' : '' }}</p>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6">
                            <h6 class="text-muted">Statut</h6>
                            <p>
                                {% if reservation.confirmed %}
                                    <span class="badge bg-success">Confirmée</span>
                                {% else %}
                                    <span class="badge bg-warning">En attente</span>
                                {% endif %}
                            </p>
                        </div>
                    </div>
                </div>
            </div>

            {% if payment %}
            <div class="card shadow">
                <div class="card-header bg-success text-white">
                    <h5 class="mb-0">Informations de paiement</h5>
                </div>
                <div class="card-body">
                    <div class="row mb-4">
                        <div class="col-md-6">
                            <h6 class="text-muted">Location</h6>
                            <p class="fs-4 fw-bold text-success mb-1">{{ payment.rent_amount }} {{ payment.currency_symbol }}</p>
                            <small class="text-muted">Statut: {{ payment.rent_status }}</small>
                            <br>
                            <small class="text-muted">ID: {{ payment.rent_intent_id }}</small>
                        </div>
                        <div class="col-md-6">
                            <h6 class="text-muted">Caution</h6>
                            <p class="fs-4 fw-bold text-warning mb-1">{{ payment.caution_amount }} {{ payment.currency_symbol }}</p>
                            <small class="text-muted">Total payé (avec frais): {{ payment.caution_with_fees }} {{ payment.currency_symbol }}</small>
                            <br>
                            <small class="text-muted">ID: {{ payment.caution_intent_id }}</small>
                        </div>
                    </div>

                    
                </div>
            </div>
            {% endif %}
        </div>

        <div class="col-md-4">
            {% set isFinished = reservation.endDate < date() %}
            {% if isFinished %}
                <div class="card shadow border-success mb-4">
                    <div class="card-header bg-success text-white">
                        <h5 class="mb-0">Envoyer un lien d’avis</h5>
                    </div>
                    <div class="card-body">
                        <form method="post" action="{{ path('admin_reservation_send_review', {id: reservation.id}) }}">
                            <input type="hidden" name="_token" value="{{ csrf_token('send_review' ~ reservation.id) }}">
                            <button type="submit" class="btn btn-success w-100">
                                Envoyer un email Trustpilot
                            </button>
                        </form>
                    </div>
                </div>
            {% endif %}

            {% if payment %}
            <div class="card shadow border-warning">
                <div class="card-header bg-warning">
                    <h5 class="mb-0">Remboursement caution</h5>
                </div>
                <div class="card-body">
                    {% if reservation and not reservation.isCautionRefunded() and not reservation.isCautionConcerved() %}
                    <form method="post" action="{{ path('admin_refund_caution', {id: reservation.id}) }}" 
                          id="caution-refund-form">
                        <input type="hidden" name="caution_intent_id" value="{{ payment.caution_intent_id }}">

                        <div class="mb-3">

                            <div id="partial-amount-container" class="ms-4 mb-3" style="display:none;">
                                <label class="form-label">Montant à rembourser</label>
                                <div class="input-group">
                                    <input type="number" class="form-control" name="amount" 
                                           step="0.01" min="0" max="{{ payment.caution_amount }}" 
                                           placeholder="0.00">
                                    <span class="input-group-text">{{ payment.currency_symbol }}</span>
                                </div>
                                <small class="text-muted">Max: {{ payment.caution_amount }} {{ payment.currency_symbol }}</small>
                            </div>

                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" name="conserve" 
                                       value="none" id="none">
                                <label class="form-check-label" for="none">
                                    Conserver la caution
                                    <br>
                                    <small class="text-danger">Aucun remboursement</small>
                                </label>
                            </div>
                        </div>

                        <button class="btn btn-warning w-100" id='caution-refund-btn'>
                            Valider
                        </button>
                    </form>

                    {% elseif reservation.isCautionConcerved() %}
                    <div class="alert alert-success">
                        <h6 class="fw-bold">✓ Caution conservée</h6>
                        <p class="mb-0">
                            {{ payment.caution_amount }} {{ payment.currency_symbol }} conservés par l'hôte.
                        </p>
                    </div>
                    {% elseif reservation.isCautionRefunded() %}
                    <div class="alert alert-success">
                        <h6 class="fw-bold">✓ Caution remboursée</h6>
                        <p class="mb-0">
                            {{ payment.caution_amount }} {{ payment.currency_symbol }} remboursés au client.
                        </p>
                    </div>
                    {% endif %}
                </div>
            </div>
            {% else %}
            <div class="alert alert-info">
                <h6 class="fw-bold">ℹ Réservation créée en mode administrateur</h6>
                <p class="mb-0">
                    Cette réservation a été créée sans paiement Stripe. Aucune caution n'a été collectée.
                </p>
            </div>
            {% endif %}
        </div>
    </div>
</div>
<script>
const checkbox = document.getElementById('none');
const button = document.getElementById('caution-refund-btn');

if (checkbox && button) {
    // Initialisation
    button.textContent = checkbox.checked ? 'Conserver la caution' : 'Rembourser la caution';
    
    // Écoute les changements
    checkbox.addEventListener('change', function() {
        button.textContent = this.checked ? 'Conserver la caution' : 'Rembourser la caution';
    });
}
</script>

{% endblock %}