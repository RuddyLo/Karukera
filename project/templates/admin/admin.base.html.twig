<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% block title %}Mon Application{% endblock %}</title>
    <link href="{{asset('images/icons/favicon.png')}}" rel="icon">
    {% block stylesheets %}
    <link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />
        {{ encore_entry_link_tags('app') }}   
       
    {% endblock %}
        {% block javascripts %}
            {{ encore_entry_script_tags('app') }}
            {{ include('ajaxLink.html.twig') }}


        {% endblock %}
</head>


    {% block body %}
    <div class="container-fluid">
        <div class="row flex-nowrap  overflow-auto">

            {# Sidebar #}
            <div class="col-auto col-md-3 col-xl-2 px-sm-2 px-0 bg-dark fixed sidebar">
                <div class="d-flex flex-column align-items-center align-items-sm-start px-2 pt-2 text-white">
                    <a href="/" class="d-flex align-items-center pb-3 mb-md-0 me-md-auto text-white text-decoration-none">
                        <span class="fs-5 d-none d-sm-inline">Logo et lien vers la page accueil</span>
                    </a>
                    <ul class="nav nav-pills flex-column mb-sm-auto mb-0 align-items-center align-items-sm-start" id="menu">
                        <li class="nav-item py-2">
                            <a href="{{ path('admin.user')}}" class="nav-link px-0 align-middle text-white">
                                <i class="bi bi-people-fill mx-4"></i><span class="ms-1 d-none d-sm-inline">Utilisateurs</span>
                            </a>
                        </li>
                        <li class="nav-item py-2">
                            <a href="{{path('admin.equipment')}}" class="nav-link px-0 align-middle text-white">
                                <i class="bi bi-people-fill mx-4"></i><span class="ms-1 d-none d-sm-inline">Équipements</span>
                            </a>
                        </li>
                        <li class="nav-item py-2">
                            <a href="{{ path('admin.apartment') }}" class="nav-link px-0 align-middle text-white">
                                <i class="bi bi-house mx-4"></i> <span class="ms-1 d-none d-sm-inline">Appartements</span>
                            </a>
                        </li>
                        <li class="nav-item py-2">
                            <a href="{{path('price_period_index')}}" class="nav-link px-0 align-middle text-white">
                                <i class="bi bi-people-fill mx-4"></i><span class="ms-1 d-none d-sm-inline">Prix</span>
                            </a>
                        </li>
                        <li class="nav-item py-2">
                            <a href="{{ path('minimum_stay_period_index') }}" class="nav-link px-0 align-middle text-white">
                                <i class="bi bi-calendar-check mx-4"></i><span class="ms-1 d-none d-sm-inline">Durée minimale</span>
                            </a>
                        </li>
                        <li class="nav-item py-2">
                            <a href="{{ path('admin.social_media') }}" class="nav-link px-0 align-middle text-white">
                                <i class="bi bi-share-fill mx-4"></i><span class="ms-1 d-none d-sm-inline">Réseaux sociaux</span>
                            </a>
                        </li>
                        <li class="nav-item py-2">
                            <a href="{{path('admin.news.index')}}" class="nav-link px-0 align-middle text-white">
                                <i class="bi bi-people-fill mx-4"></i><span class="ms-1 d-none d-sm-inline">Nouveautés</span>
                            </a>
                        </li>
                        <li class="nav-item py-2">
                            <a href="{{path('blog_admin')}}" class="nav-link px-0 align-middle text-white">
                                <i class="bi bi-people-fill mx-4"></i><span class="ms-1 d-none d-sm-inline">Blog</span>
                            </a>
                        </li>
                        <li class="nav-item py-2">
                            <a href="{{path('admin_reservations_list')}}" class="nav-link px-0 align-middle text-white">
                                <i class="bi bi-people-fill mx-4"></i><span class="ms-1 d-none d-sm-inline">Réservations</span>
                            </a>
                        </li>
                        <li class="nav-item py-2">
                            <a href="{{path('coupon_index')}}" class="nav-link px-0 align-middle text-white">
                                <i class="bi bi-tags-fill mx-4"></i><span class="ms-1 d-none d-sm-inline">Coupons</span>
                            </a>
                        </li>

                        <li class="nav-item py-2 w-100 text-center">
                            <a href="{{ path('app.logout') }}" class="nav-link px-4 align-middle bg-danger w-100 text-white">
                                <i class="bi bi-box-arrow-left"></i> <span class="ms-1 d-none d-sm-inline">Déconnexion</span>
                            </a>
                        </li>
                    </ul>
                    <hr>
                </div>
            </div>

            {# Contenu principal #}
            <div class="col py-3 w-100 content-wrapper">
                {% for label, messages in app.flashes %}
                    {% for message in messages %}
                        <div class="alert alert-{{ label == 'error' ? 'danger' : label }} alert-dismissible fade show" role="alert">
                            {{ message }}
                            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                        </div>
                    {% endfor %}
                {% endfor %}

                {% block content %}
            
                {% endblock %}
            </div>
        </div>
    </div>
    {% endblock body %}


</html>
