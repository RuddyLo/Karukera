{% extends 'admin/admin.base.html.twig' %}

{% block title %}Réseaux sociaux{% endblock %}

{% block content %}
<div class="m-4">
    <div class="table-container container w-100">
        <h1 class="py-4">Liste des réseaux sociaux</h1>
        <table style="width: 100%;" id="social-media-table" class="table table-hover table-striped">
            <thead class="table-dark text-white font-weight-bold">
                <tr>
                    <th class="">Id</th>
                    <th class="">Plateforme</th>
                    <th class="">URL</th>
                    <th class="">Icône</th>
                    <th class="">Actions</th>
                </tr>
            </thead>
        </table>
        <button class="btn btn-info text-white mt-3">
            <a class="text-white" href="{{ path('admin.social_media.new') }}">Créer un nouveau</a>
        </button>
    </div>

    <form method="post" id="delete-social-media-form" action="{{ path('admin.social_media.delete') }}" hidden>
        <input type="hidden" name="csrf-token" id="delete-social-media-token" value="{{ csrf_token('delete-social-media-karukera') }}">
        <input type="hidden" name="id" id="delete-social-media-id">
    </form>
</div>

{% block javascripts %}
    {{ parent() }}
<script>
window.addEventListener('DOMContentLoaded', function () {
    if (typeof window.$ === 'undefined') {
        return;
    }

    if (!$.fn.dataTable.isDataTable('#social-media-table')) {
        $('#social-media-table').DataTable({
            responsive: true,
            processing: true,
            serverSide: false,
            pageLength: 10,
            order: [[0, 'desc']],
            ajax: {
                url: '{{ path('admin.ajax.social_media') }}',
                dataSrc: 'data'
            },
            columns: [
                { data: 0 },
                { data: 1 },
                { data: 2 },
                { data: 3 },
                { data: 4, orderable: false }
            ],
            columnDefs: [
                {
                    targets: 4,
                    render: function (data, type, row) {
                        return `
                            <div class="d-flex justify-content-center list-action-group">
                                <span>
                                    <a title="Voir" href='${ajaxLink.social_media.show.replace('123456789', row[0])}' class='btn btn-sm btn-info mr-2'>Voir</a>
                                    <a title="Modifier" href='${ajaxLink.social_media.edit.replace('123456789', row[0])}' class='btn btn-sm btn-warning mr-2'>Modifier</a>
                                    <button title="Suppression" class='btn btn-sm btn-danger event-delete-social-media' data-uuid=${row[0]}>
                                        <i class="bi bi-trash3-fill"></i>
                                    </button>
                                </span>
                            </div>
                        `;
                    }
                }
            ],
            language: dataTableTranslation
        });
    }
});
</script>
{% endblock %}
{% endblock %}