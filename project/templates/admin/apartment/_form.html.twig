<div class="p-2 w-100">
    {{ form_start(form, { attr: { novalidate: "novalidate" } }) }}
    <div class="row">
        {{ form_row(form.name) }}
    </div>
    <div class="row">
        {{ form_row(form.description) }}
    </div>

    <div class="row">
        {{ form_row(form.is_active) }}
        {{ form_row(form.is_favorite) }}
    </div>

    <div class="col-sm-12 col-lg-6 image-uploader w-auto p-4"> 
        <div class="rr-homepage-image-container ">
            <h4>Image </h4>
            {# <span class="text-muted mb-2"><span class="text-danger text-xs">max 171x213 pixels format .png *</span></span> #}
            <div class="d-flex row align-items-center">
                <button type="button" class="image-toggler btn btn-primary mr-4 w-20">Choisir une image</button>
                <img id="image-preview"  src="{{ asset('images/img/placeholder-image.png') }}" alt="Choisir une image au format attendu" class="w-4 h-4 rr-apartment-image mx-auto" />
            </div>
        </div>
        <div class="row">

            {{ form_row(form.imageUrl,{ 'id': 'apartment_form_imagerUrl' }) }}
        </div>
    </div>
    
    
    

    <button type="submit" class="btn btn-primary mt-4">Enregistrer</button>
    <a class="btn btn-secondary mt-4" href="{{ path('admin.apartment') }}">Annuler</a>
    {{ form_end(form) }}

</div>