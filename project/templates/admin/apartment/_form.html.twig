<div class="p-2 w-100">

    {{ form_start(form,{'attr': {'id': 'apartmentForm'}}) }}
    <div class="shadow border border-radius p-4 mb-4">
        {# --- Calendrier --- #}
        <div class="price-calendar-container">
            <div id="price-calendar"></div>
        </div>
        <div class="row">
             {{ form_row(form.pricePeriod.price) }}
        </div>
        <div class="row">
             {{ form_row(form.pricePeriod.startDate) }}
             {{ form_row(form.pricePeriod.endDate) }}
        </div>
    </div>
    <div class="row">
        {{ form_row(form.locale) }}
       
    </div>
    <div class="row">
        {{ form_row(form.name) }}
        {{ form_row(form.price) }}
    </div>
    
    <div class="row">
        {{ form_row(form.description) }}
    </div>

    <div class="row">
        {{ form_row(form.is_active) }}
        {{ form_row(form.is_favorite) }}
    </div>

    <div class="row p-4 shadow rounded">
        <label for="{{ form.equipments.vars.id }}">{{ form.equipments.vars.label }}</label>
        {{ form_widget(form.equipments, {'attr': {'class': 'dropdown-checkbox form-control'}}) }}
    </div>

    <div class="col-sm-12 col-lg-6 image-uploader w-auto p-4"> 
        <div class="rr-homepage-image-container ">
            <h4>Image </h4>
            {# <span class="text-muted mb-2"><span class="text-danger text-xs">max 171x213 pixels format .png *</span></span> #}
            <div class="d-flex row align-items-center">
                <button type="button" class="image-toggler btn btn-primary mr-4">Choisir une image à mettre en avant</button>
                {% if apartment is defined and apartment.imageUrl is not empty %}
                <img id="image-preview"  src="{{ asset(apartment.imageUrl) }}" alt="Choisir une image au format attendu" class="w-4 h-4 rr-apartment-image mx-auto" />
                {% else %}
                <img id="image-preview"  src="{{ asset('images/img/placeholder-image.png') }}" alt="Choisir une image au format attendu" class="w-4 h-4 rr-apartment-image mx-auto" />
                {% endif %}
                
            </div>
        </div>
        <div class="row">

            {{ form_row(form.imageUrl,{ 'id': 'apartment_form_imagerUrl' }) }}
        </div>
        {# Upload AJAX image par image #}
        <div class="p-4 shadow mt-3 mb-3">
            <label class="form-label fw-semibold">Images de l'appartement</label>
            <div class="mb-2 d-flex align-items-center gap-2">
                <label for="apartment-images-input" class="btn btn-outline-primary mb-0">
                    <i class="bi bi-images"></i> Ajouter des photos
                </label>
                <input type="file" id="apartment-images-input" multiple accept="image/jpeg,image/png,image/webp" class="d-none">
                <small class="text-muted">PNG, JPG, WEBP — compressées automatiquement</small>
            </div>
            <div id="upload-status" class="text-muted small mb-2" style="display:none;"></div>
            <div id="apartment-images-preview" class="row mt-2"></div>
        </div>
            {% if apartment is defined %}
            <div class="row mt-3" id="existing-images">
                {% for image in apartment.images %}
                    <div class="col-md-3 image-container" data-image-id="{{ image.id }}">
                        <img src="{{ asset(image.url) }}" 
                             alt="Image de l'appartement" 
                             class="img-fluid rounded shadow-md" />
                        <button type="button" class="btn btn-danger btn-sm mt-2 btn-remove-apartment-image" >
                            <i class="bi bi-trash-fill"></i>
                        </button>
                    </div>
                {% endfor %}
            </div>
            {% endif %}
            
        </div>

    </div>
    
    
    <div class="">
        <button type="submit" class="btn btn-success mt-4">Enregistrer</button>
        <a class="btn btn-secondary mt-4" href="{{ path('admin.apartment') }}">Annuler</a>
    </div>

    
    {{ form_end(form) }}

</div>

{# --- FullCalendar --- #}
<link href='https://cdn.jsdelivr.net/npm/fullcalendar@6.1.15/index.global.min.css' rel='stylesheet' />
<script src='https://cdn.jsdelivr.net/npm/fullcalendar@6.1.15/index.global.min.js'></script>
<script>
document.addEventListener('DOMContentLoaded', function() {
    var calendarEl = document.getElementById('price-calendar');
    var calendar = new FullCalendar.Calendar(calendarEl, {
        initialView: 'dayGridMonth',
        locale: 'fr',
        {% if apartmentId %}
            events: '{{ path("pridePeriode.json", { id: apartmentId }) }}',
            {% else %}
            events: '{{ path("pridePeriode.json", { id: 0 }) }}',
        {% endif %}
        events: '{{ path("pridePeriode.json", { id: apartmentId }) }}', 
        selectable: true,
        selectAllow: function(selectInfo) {
            var events = calendar.getEvents();
            for (let event of events) {
                if ((selectInfo.start < event.end) && (selectInfo.end > event.start)) {
                    return false;
                }
            }
            return true;
        },
        select: function(info) {
            document.getElementById('apartment_form_pricePeriod_startDate').value = info.startStr;
            document.getElementById('apartment_form_pricePeriod_endDate').value = info.endStr;
        }
    });
    calendar.render();
});
</script>
