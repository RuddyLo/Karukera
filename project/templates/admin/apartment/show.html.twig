{% extends 'admin/admin.base.html.twig' %}

{% block title %}Apartment{% endblock %}

{% block content %}

<div class="card-container  flex justify-content-center align-item-center col-sm-2 col-md-6  d-flex mt-4 py-4" >
      <div class="card appart-card border-0 shadow p-4">
        <div class="member-img">
            {% if apartment.imageUrl != null and apartment.imageUrl != "" %}
            <img src="{{asset(apartment.imageUrl)}}" class="img-fluid rounded" alt=""> 
            {% else %}
            <img rc="{{ asset('images/img/placeholder-image.png') }}" class="img-fluid rounded" alt="">
            {% endif %}
          
        </div>
        <div class="card-info p-2">
          <div class="badges my-2">
            {% if apartment.isActive %}
              <span class="text-succes font-">Actif</span>
            
            {% else %}
              <span class="text-danger bold-500">Pas actif</span>
            {% endif %}
          </div>
          <div class="container flex justify-between items-center">
              <span class="appart-name">Prix par défaut: {{ apartment.price }}</span>

              {% if pricePeriod %}
                  <span class="text-xs"> | Prix pour la période actuelle {{ pricePeriod.price }}</span>
              {% else %}
                  <span class="text-xs">Pas de prix spécifique pour cette période</span>
              {% endif %}
          </div>

          <div class="container">
              <div class="row">
               <span class="appart-name  text-bold">{{apartment.name}}</span></br>
                <span class="text-xs">{{apartment.description}}</span>
              </div>
          </div>
         
        </div>
      </div>
  </div>
  <div class="row  mt-3" id="existing-images">
    {% for image in apartment.images %}
        <div class="col-md-3 image-container" data-image-id="{{ image.id }}">
            <img src="{{ asset(image.url) }}" 
                 alt="Image de l'appartement" 
                 class="img-fluid rounded shadow-md" />
            
        </div>
    {% endfor %}
</div>
  <div class="col ">
    <div>
      <a class="btn btn-secondary mt-4" href="{{ path('admin.apartment') }}">Retour</a>
      <a class="btn btn-primary mt-4" href="{{ path('admin.apartment.edit',{id : apartment.id}) }}">Modifier</a>
      <button class="btn btn-danger mt-4" id="toggle-apartment-delete">Supprimer cet Appartement</button>
    </div>
  </div>
  {{ include('admin/apartment/_delete_form.html.twig') }}

{% endblock %}
