{% extends 'admin/admin.base.html.twig' %}

{% block title %}Modifier Période de Minimum de Séjour{% endblock %}

{% block content %}
<div class="container mt-4">
    <div class="row mb-4">
        <div class="col-md-8">
            <h1>Modifier Période de Minimum de Séjour</h1>
        </div>
        <div class="col-md-4 text-end">
            <a href="{{ path('minimum_stay_period_index') }}" class="btn btn-secondary">
                ← Retour
            </a>
        </div>
    </div>

    <div class="card">
        <div class="card-body">
            {{ form_start(form) }}
            <div class="row">
                <div class="col-md-6">
                    {{ form_row(form.apartment) }}
                </div>
            </div>
            <div class="row">
                {{ form_row(form.minimumDays) }}
            </div>
            <div class="row">
                {{ form_row(form.startDate) }}
                {{ form_row(form.endDate) }}
            </div>

            <div class="mt-3">
                <button class="btn btn-primary">Modifier</button>
            </div>
            {{ form_end(form) }}

            <form method="POST" action="{{ path('minimum_stay_period_delete', {'id': minimum_stay_period.id}) }}" class="mt-2">
                <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ minimum_stay_period.id) }}">
                <button type="submit" class="btn btn-danger" onclick="return confirm('Êtes-vous sûr ?')">Supprimer</button>
            </form>
        </div>
    </div>
</div>
{% endblock %}
