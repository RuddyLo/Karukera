{% extends 'admin/admin.base.html.twig' %}

{% block title %}Equipment index{% endblock %}

{% block content %}
<div class="m-4 ">
    <div class="table-container container w-100">
        <h1 class="py-4">Liste des Équipements</h1>
        <table style="width: 100%;" id="equipment-table" class="table table-hover able-striped  ">
            <thead class="table-dark text-white font-weight-bold">
                <tr>
                    <th class="">Id</th>
                    <th class="">Nom</th>
                    <th class="">Actions</th>
                </tr>
            </thead>
        </table>
        <button class="btn btn-info text-white"><a class=" text-white" href="{{ path('admin.equipment.new') }}">Créer un nouveau</a></button>
    </div>
    <form method="post" id="delete-equipment-form" action="{{ path('admin.equipment.delete') }}" hidden>
        <input type="hidden" name="csrf-token" id="delete-equipment-karukera" value={{csrf_token('delete-equipment-karukera')}}>
        <input name="id" type="hidden" id="delete-equipment-id">
    </form>
    
<div>
    
{% endblock %}

