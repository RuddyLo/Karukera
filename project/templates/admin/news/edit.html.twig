{% extends "admin/admin.base.html.twig" %}

{% block content %}
<div class="container p-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="fw-bold">Éditer la nouveauté</h2>
        <div>
            <a href="{{ path('admin.news.edit', {id: news.id, locale: 'fr'}) }}" 
               class="btn btn-lg {{ locale == 'fr' ? 'btn-primary' : 'btn-outline-secondary' }}">🇫🇷</a>
            <a href="{{ path('admin.news.edit', {id: news.id, locale: 'en'}) }}" 
               class="btn btn-lg {{ locale == 'en' ? 'btn-primary' : 'btn-outline-secondary' }}">🇺🇸</a>
        </div>
    </div>

    {% for label, messages in app.flashes %}
        {% for message in messages %}
            <div class="alert alert-{{ label }}">{{ message }}</div>
        {% endfor %}
    {% endfor %}

    {# Images existantes #}
    {% if news.newsImages|length > 0 %}
    <div class="row mb-4">
        {% for image in news.newsImages %}
        <div class="col-md-3 mb-2">
            <img src="{{ asset(image.url) }}" class="img-fluid rounded" style="height:150px; object-fit:cover;">
            <a href="{{ path('admin.news.image.delete', {id: image.id}) }}" 
               class="btn btn-sm btn-danger m-2"
               onclick="return confirm('Supprimer cette image ?')">
               <i class="bi bi-trash"></i>
            </a>
        </div>
        {% endfor %}
    </div>
    {% endif %}

    <div class="alert alert-info">
        Vous éditez la version : <strong>{{ locale == 'fr' ? '🇫🇷 Français' : '🇺🇸 English' }}</strong>
    </div>

    {{ form_errors(form) }}
    {{ form_start(form, {'attr': {'enctype': 'multipart/form-data'}}) }}

        {# Locale cachée, forcée par le drapeau sélectionné #}
        {{ form_widget(form.locale, {'attr': {'style': 'display:none'}}) }}

        <div class="mb-3">{{ form_row(form.description) }}</div>

        <div class="mb-3">
    <label class="form-label fw-bold">Ajouter des images</label>
    <div class="border rounded p-3 bg-light" style="border-style: dashed !important;">
        {{ form_widget(form.images) }}
        {{ form_errors(form.images) }}
        <small class="text-muted mt-2 d-block">Formats acceptés : JPG, PNG, WEBP</small>
    </div>
</div>
<div class="mb-3">{{ form_row(form.active) }}</div>
        <button type="submit" class="btn btn-success">Enregistrer</button>
        <a href="{{ path('admin.news.index') }}" class="btn btn-secondary">Annuler</a>

    {{ form_end(form) }}
</div>

<script>
document.addEventListener('DOMContentLoaded', function () {
    const localeSelect = document.querySelector('select[name="news_form[locale]"]');
    if (localeSelect) {
        localeSelect.value = '{{ locale }}';
    }
});
</script>

{% endblock %}