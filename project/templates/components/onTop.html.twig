
<section id="on-top" class="on-top d-flex justify-content-center ">
    <div class="container  ">
      <div class=" my-auto">
          <h2 class="font-weight-bold">Profitez d'un séjour exeptionnel dans les meilleurs appartements !</h2>
          <p class="text-secondary">Ea vitae aspernatur deserunt voluptatem impedit deserunt magnam occaecati dssumenda quas ut ad dolores adipisci aliquam.</p>
      </div>
      <div class="row ">
      {% for apartment in apartments_on_top %}
        
        <div class="card-container d-flex col-md-4 mb-2" >
            <a href="{{path('app.apartment.details', {id: apartment.getId()})}}">
                <div class="card appart-card border-0">
                    <div class="rounded">
                        <img src="{{asset(apartment.imageUrl)}}" class="on-top-img rounded" alt="">
                    </div>
                    <div class="card-info p-2">
                        <div class="badges my-2">
                            <span class="text-primary"><i class="bi bi-star"></i></span>
                            <span class="text-primary"><i class="bi bi-open"></i></span>
                        </div>
                        <span class="appart-name">{{apartment.name}}</span></br>
                        <span>{{apartment.description}}</span>
                    </div>
                </div>
            </a>
        </div>
        
      {% endfor %}
    </div><!-- End appart item -->
      
    {% if display_more %}
    <div class="container d-flex flex-column align-items-center" style="margin-top: 6rem;">
        <a href="{{ path('app.apartments') }}"><button class="mt-auto btn show-all-apartments">
          Voir tous les appartements <i class="mx-2 bi bi-arrow-right-square-fill"></i>
        </button> </a> 
    </div>
    {% endif %}

    </div>
    

  </section>