{% extends 'base.html.twig' %}

{% block content %}
<section id="contact" class="contact">
    <div class="container">
        <div class="section-header">
            <h2>{{ 'contact.title'|trans }}</h2>
            <p>{{ 'contact.subtitle'|trans }}</p>
        </div>
    </div>

    <div class="container">
        <div class="row gy-5 gx-lg-5">

            <div class="col-lg-8">

                {% for flash in app.flashes('success') %}
                    <div class="alert alert-success">{{ flash|trans }}</div>
                {% endfor %}

                {{ form_start(form) }}

                <div class="row">
                    <div class="col-md-6 form-group">
                        {{ form_widget(form.name) }}
                    </div>
                    <div class="col-md-6 form-group mt-3 mt-md-0">
                        {{ form_widget(form.email) }}
                    </div>
                </div>

                <div class="form-group mt-3">
                    {{ form_widget(form.subject) }}
                </div>

                <div class="form-group mt-3">
                    {{ form_widget(form.message) }}
                </div>

                <div class="row border border-radius-2 p-2 mt-3">
                    <span class="p-2 text-muted text-sm">
                        {{ 'contact.form.stay'|trans }}
                        <span class="text-xs">{{ 'contact.form.stay_optional'|trans }}</span>
                    </span>
                    <div class="col-md-6 form-group">
                        <span class="text-xs p-2">{{ 'contact.form.start_date'|trans }}</span>
                        {{ form_widget(form.start_date) }}
                    </div>
                    <div class="col-md-6 form-group mt-3 mt-md-0">
                        <span class="text-xs p-2">{{ 'contact.form.end_date'|trans }}</span>
                        {{ form_widget(form.end_date) }}
                    </div>
                </div>

                <div class="text-center mt-3">
                    <button type="submit" class="btn btn-primary">
                        {{ 'contact.form.submit'|trans }}
                    </button>
                </div>

                {{ form_end(form) }}

            </div>

            <div class="col-lg-4">
                <div class="info">
                    <div class="info-item d-flex">
                        <i class="bi bi-geo-alt flex-shrink-0"></i>
                        <div>
                            <h4>Adresse:</h4>
                            <p>oasis de karurio, 12 rue morne tricolore 97180 Sainte Anne</p>
                        </div>
                    </div>
                    <div class="info-item d-flex">
                        <i class="bi bi-envelope flex-shrink-0"></i>
                        <div>
                            <h4>Email:</h4>
                            <p>contact@karurio.com</p>
                        </div>
                    </div>
                    <div class="info-item d-flex">
                        <i class="bi bi-phone flex-shrink-0"></i>
                        <div>
                            <h4>Whatsapp:</h4>
                            <p>+33 755503086</p>
                        </div>
                    </div>
                </div>
            </div>

        </div>
    </div>
</section>
{% endblock %}