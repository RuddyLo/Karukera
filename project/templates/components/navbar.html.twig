<div class="navbar-container fixed-top w-2 container-fluid d-flex align-items-center justify-content-between">

    <a href="{{ path('app.home', {'_locale': app.request.locale}) }}" class="logo d-flex align-items-center me-auto me-lg-0">
        <h1 class=""> Les Oasis
            <span>de Karurio</span>.
        </h1>
    </a>

    <nav id="navbar" class="navbar">
        <ul>
            <li class="nav-link">
                <a href="{{ path('app.home', {'_locale': app.request.locale}) }}">
                    <span>{{ 'nav.home'|trans }}</span>
                </a>
            </li>

            <li>
                <a class="nav-link" href="{{ path('app.contact', {'_locale': app.request.locale}) }}">
                    {{ 'nav.contact'|trans }}
                </a>
            </li>

            {% if not app.user %}
                <li>
                <a class="nav-link scrollto color-primary border-primary fw-bold" href="{{ path('app.register', {_locale: app.request.locale}) }}">
                   
                        {{ 'nav.register'|trans }}
                    </a>
                </li>
            {% endif %}
            {% if app.user and 'ROLE_ADMIN' in app.user.roles %}
                <li>
                    <a class="nav-link scrollto color-orange border-primary fw-bold" href="{{ path('app.admin') }}">
                        {{ 'nav.admin'|trans }}
                    </a>
                </li>
            {% endif %}
            {% if app.user %}
                <li>
                    <a class="nav-link scrollto" href="{{ path('app.user.reservations', {_locale: app.request.locale}) }}">
                        {{ 'nav.my_reservations'|trans }}
                    </a>
                </li>
            {% endif %}

            {% if not app.user %}
                <li>
                    <a class="btn-getstarted scrollto" href="{{ path('app.login', {'_locale': app.request.locale}) }}">
                        {{ 'nav.login'|trans }}
                    </a>
                </li>
            {% else %}
                <li>
                    <a class="nav-link text-danger scrollto" href="{{ path('app.logout', {'_locale': app.request.locale}) }}">
                        {{ 'nav.logout'|trans }}
                    </a>
                </li>
            {% endif %}

            

            <li class="nav-item">
                <div class="language-switcher d-flex ">
                    <a href="{{ path(app.request.attributes.get('_route'),
                        app.request.attributes.get('_route_params')|merge({'_locale': 'fr'})) }}">
                        FR
                    </a>
                    <a href="{{ path(app.request.attributes.get('_route'),
                        app.request.attributes.get('_route_params')|merge({'_locale': 'en'})) }}">
                        EN
                    </a>
                </div>
            </li>

        </ul>
        <i class="bi bi-list mobile-nav-toggle d-none"></i>
    </nav>
</div>