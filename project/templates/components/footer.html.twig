<footer id="footer" class="footer">

    <div class="footer-content">
      <div class="container">
        <div class="row align-items-start">

          <div class="col-lg-3 col-md-6">
            <div class="footer-info">
              <h1 class="">Les Oasis <span>de Karurio</span>.</h1>
              <p>
                oasis de karurio, 12 rue morne tricolore 97180 Sainte Anne<br>
                <strong>{{ 'footer.phone'|trans }}:</strong> +33 755503086<br>
                <strong>{{ 'footer.email'|trans }}:</strong> contact@oasiskarurio.com<br>
              </p>
            </div>
          </div>

          <div class="col-lg-2 col-md-6 footer-links">
            <h4>{{ 'footer.links.title'|trans }}</h4>
            <ul>
              <li><i class="bi bi-chevron-right"></i> <a href="{{ path('app.home', {_locale: app.request.locale}) }}">{{ 'footer.links.home'|trans }}</a></li>
              <li><i class="bi bi-chevron-right"></i> <a href="{{ path('app.contact', {_locale: app.request.locale}) }}">{{ 'footer.links.contact'|trans }}</a></li>
              <li><i class="bi bi-chevron-right"></i> <a href="{{ path('app.register', {_locale: app.request.locale}) }}">{{ 'footer.links.register'|trans }}</a></li>
              <li><i class="bi bi-chevron-right"></i> <a href="{{ path('app.login', {'_locale': app.request.locale}) }}">{{ 'footer.links.login'|trans }}</a></li>
            </ul>
          </div>

          <div class="col-lg-2 col-md-6 footer-links">
            <h4>{{ 'footer.legal.title'|trans }}</h4>
            <ul>
              <li><i class="bi bi-chevron-right"></i> <a href="{{ path('app.legal.privacy', {_locale: app.request.locale}) }}">{{ 'footer.legal.privacy'|trans }}</a></li>
              <li><i class="bi bi-chevron-right"></i> <a href="{{ path('app.legal.cgv', {_locale: app.request.locale}) }}">{{ 'footer.legal.cgv'|trans }}</a></li>
              <li><i class="bi bi-chevron-right"></i> <a href="{{ path('app.legal.mentions', {_locale: app.request.locale}) }}">{{ 'footer.legal.mentions'|trans }}</a></li>
            </ul>
          </div>

          <div class="social-links col-lg-3">
            {% if social_medias is defined and social_medias|length > 0 %}
                {% for social in social_medias %}
                    <a href="{{ social.url }}" class="btn {{ social.platform|lower }}" target="_blank" rel="noopener" title="{{ social.platform }}">
                        <i class="{{ social.icon }} text-white" style="font-size: 24px;"></i>
                    </a>
                {% endfor %}
            {% else %}
                <a href="#" class="tiktok btn"><i class="text-white bi bi-tiktok" style="font-size: 24px;"></i></a>
                <a href="#" class="twitter btn"><i class="text-white bi bi-twitter" style="font-size: 24px;"></i></a>
                <a href="#" class="facebook btn"><i class="text-white bi bi-facebook" style="font-size: 24px;"></i></a>
                <a href="#" class="instagram btn"><i class="text-white bi bi-instagram" style="font-size: 24px;"></i></a>
            {% endif %}
          </div>

        </div>
      </div>
    </div>

    <div class="footer-legal text-center">
      <div class="container d-flex flex-column flex-lg-row justify-content-center justify-content-lg-between align-items-center">
        <div class="d-flex flex-column align-items-center align-items-lg-start">
          <div class="copyright">
            &copy; Copyright <strong><span>lesoasisdekarurio</span></strong>. {{ 'footer.rights'|trans }}
          </div>
        </div>
      </div>
    </div>

</footer>