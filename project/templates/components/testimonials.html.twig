<section id="testimonials" class="py-5 bg-light">
    <div class="container">

        <div class="text-center mb-5">
            <h2 class="fw-bold" style="font-size: 40px;">{{ 'testimonials.title'|trans }}</h2>
        </div>

        <div id="testimonialCarousel" class="carousel slide mb-5" data-bs-ride="carousel">
            
            <div class="carousel-indicators">
                <button type="button" data-bs-target="#testimonialCarousel" data-bs-slide-to="0" class="active"></button>
                <button type="button" data-bs-target="#testimonialCarousel" data-bs-slide-to="1"></button>
                <button type="button" data-bs-target="#testimonialCarousel" data-bs-slide-to="2"></button>
            </div>

            <div class="carousel-inner">

                <div class="carousel-item active">
                    <div class="row justify-content-center">
                        <div class="col-lg-8 col-md-10">
                            <div class="testimonial-card p-5 bg-white shadow rounded-3 text-center">
                                <div class="mb-3"><span class="text-warning fs-4">★★★★★</span></div>
                                <h5 class="fw-bold mb-3">{{ 'testimonials.1.title'|trans }}</h5>
                                <p class="lead mb-4">{{ 'testimonials.1.content'|trans }}</p>
                                <div class="d-flex align-items-center justify-content-center">
                                    <strong>{{ 'testimonials.1.author'|trans }}</strong>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="carousel-item">
                    <div class="row justify-content-center">
                        <div class="col-lg-8 col-md-10">
                            <div class="testimonial-card p-5 bg-white shadow rounded-3 text-center">
                                <div class="mb-3"><span class="text-warning fs-4">★★★★★</span></div>
                                <h5 class="fw-bold mb-3">{{ 'testimonials.2.title'|trans }}</h5>
                                <p class="lead mb-4">{{ 'testimonials.2.content'|trans }}</p>
                                <div class="d-flex align-items-center justify-content-center">
                                    <strong>{{ 'testimonials.2.author'|trans }}</strong>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="carousel-item">
                    <div class="row justify-content-center">
                        <div class="col-lg-8 col-md-10">
                            <div class="testimonial-card p-5 bg-white shadow rounded-3 text-center">
                                <div class="mb-3"><span class="text-warning fs-4">★★★★★</span></div>
                                <h5 class="fw-bold mb-3">{{ 'testimonials.3.title'|trans }}</h5>
                                <p class="lead mb-4">{{ 'testimonials.3.content'|trans }}</p>
                                <div class="d-flex align-items-center justify-content-center">
                                    <strong>{{ 'testimonials.3.author'|trans }}</strong>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

            </div>

            <button class="carousel-control-prev" type="button" data-bs-target="#testimonialCarousel" data-bs-slide="prev">
                <span class="carousel-control-prev-icon bg-dark rounded-circle p-3" aria-hidden="true"></span>
                <span class="visually-hidden">{{ 'testimonials.prev'|trans }}</span>
            </button>
            <button class="carousel-control-next" type="button" data-bs-target="#testimonialCarousel" data-bs-slide="next">
                <span class="carousel-control-next-icon bg-dark rounded-circle p-3" aria-hidden="true"></span>
                <span class="visually-hidden">{{ 'testimonials.next'|trans }}</span>
            </button>
        </div>

        <div class="text-center">
            <a href="https://fr.trustpilot.com/review/votre-entreprise.com" 
               target="_blank" 
               rel="noopener noreferrer"
               class="btn btn-outline-success"
               style="border-width: 2px; font-weight: 600;">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor" class="me-2" style="vertical-align: middle;">
                    <path d="M12 2L15.09 8.26L22 9.27L17 14.14L18.18 21.02L12 17.77L5.82 21.02L7 14.14L2 9.27L8.91 8.26L12 2Z"/>
                </svg>
                {{ 'testimonials.trustpilot'|trans }}
            </a>
        </div>

    </div>
</section>

<style>
    .carousel-control-prev-icon,
    .carousel-control-next-icon {
        filter: invert(1);
    }
    .carousel-item {
        transition: transform 0.6s ease-in-out;
    }
    .carousel-inner {
        min-height: 350px;
    }
</style>