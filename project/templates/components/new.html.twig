<section class="py-5 nouveautes-section">
    <div class="container">

        <!-- TITLE -->
        <div class="text-center mb-4">
            <h2 class="fw-bold" style="font-size: 40px;">Nouveautés</h2>
            <p class="text-muted mt-3" style="font-size: 17px;">
                Idéalement situés en hyper-centre, tous nos biens sont meublés et décorés par nos décoratrices 
                d'intérieur pour un confort exceptionnel.
            </p>
        </div>

        <!-- IMAGES -->
        <div class="row justify-content-center gy-4 mt-4">

        {% for apartment in last_apartments %}

            <div class="col-md-6">
                <img src="{{ asset(apartment.imageUrl) }}"
                     alt="Nouveauté 1"
                     class="img-fluid rounded-3 shadow-sm">
            </div>

        {% endfor %}
        </div>
    </div>
</section>