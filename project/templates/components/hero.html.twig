<!-- HERO -->
<section class="hero">
  <div class="hero-overlay"></div>

  <div class="hero-content">
      <h1>Louez votre appartement au meilleur prix!</h1>

      <!-- Searchbar -->
        <form class="hero-search" method="GET" action="{{ path('app.search_apartment') }}">

        {# Emplacement (Dropdown) #}
        <div class="field float-field">
            <select name="apartment" required>
                <option value="" disabled selected hidden></option>
                {% for apartment in apartments %}
                    <option value="{{ apartment.name }}">{{ apartment.name }}</option>
                {% endfor %}
            </select>
            <label>Appartement</label>
        </div>

        {# Date Range #}
        <div class="field date-range">

            <div class="float-field-inner date-trigger" data-type="start">
                <label id="startLabel">Départ</label>
            </div>

            <span class="separator"></span>

            <div class="float-field-inner date-trigger" data-type="end">
                <label id="endLabel">Arrivée</label>
            </div>

            {# Hidden inputs that will be submitted #}
            <input type="hidden" name="startDate" id="startDateInput">
            <input type="hidden" name="endDate" id="endDateInput">

            <div id="calendar-tooltip" class="calendar-tooltip hidden">
                <div id="calendar"></div>
            </div>
        </div>

        {# Invités #}
        <div class="field float-field">
            <select name="guests" required>
                <option value="" disabled selected hidden></option>
                {% for i in 1..10 %}
                    <option value="{{ i }}">{{ i }} personne{{ i > 1 ? 's' : '' }}</option>
                {% endfor %}
            </select>
            <label>Nombre de personne</label>
        </div>

        <button type="submit" class="btn-getstarted search-btn">
            <i class="bi bi-search"></i> Rechercher
        </button>

    </form>

  </div>
</section>
<link href='https://cdn.jsdelivr.net/npm/fullcalendar@6.1.15/index.global.min.css' rel='stylesheet' />
<script src='https://cdn.jsdelivr.net/npm/fullcalendar@6.1.15/index.global.min.js'></script>

<script>
document.addEventListener('DOMContentLoaded', function () {

    const tooltip = document.getElementById('calendar-tooltip');
    const startLabel = document.getElementById('startLabel');
    const endLabel = document.getElementById('endLabel');

    let currentSelection = null; // "start" or "end"

    // ================================
    // SHOW TOOLTIP WHEN CLICKING LABEL
    // ================================
    document.querySelectorAll('.date-trigger').forEach(el => {
        el.addEventListener('click', function (event) {
            event.stopPropagation(); // prevent auto-close
            currentSelection = this.dataset.type;

            tooltip.classList.remove('hidden');

            // VERY IMPORTANT: fix the tiny calendar problem
            setTimeout(() => {
                calendar.updateSize();
            }, 10);
        });
    });

    // ================================
    // HIDE TOOLTIP WHEN CLICKING OUTSIDE
    // ================================
    document.addEventListener('click', function (event) {
        if (!event.target.closest('.calendar-tooltip') && 
            !event.target.closest('.date-trigger')) {
            tooltip.classList.add('hidden');
        }
    });

    // ================================
    // INIT FULLCALENDAR
    // ================================
    var calendarEl = document.getElementById('calendar');
    var calendar = new FullCalendar.Calendar(calendarEl, {
        initialView: 'dayGridMonth',
        locale: 'fr',
        selectable: true,
        events: '',

        select: function (info) {
            const start = info.startStr;
            const end = info.endStr;

            startLabel.innerText = start;
            endLabel.innerText = end;

            document.getElementById('startDateInput').value = start;
            document.getElementById('endDateInput').value = end;

            tooltip.classList.add('hidden');
        }
    });

    // First render
    calendar.render();
});
</script>
